<%- include('../partials/header') %>

<section class="auth-page" aria-labelledby="login-title">
  <div class="auth-frame">
    <div class="auth-visual">
      <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=1400&q=85" alt="A colorful painting in an art gallery" />
      <div class="auth-visual-copy">
        <span class="auth-kicker">ARTSPACE / COMMUNITY</span>
        <p>Every work begins with a point of view.</p>
        <span class="auth-caption">Find inspiration in the work of artists around you.</span>
      </div>
      <span class="auth-ornament" aria-hidden="true">ក</span>
    </div>

    <div class="auth-content">
      <a class="auth-back" href="/">&larr; Back to gallery</a>
      <p class="auth-eyebrow">WELCOME BACK</p>
      <h1 id="login-title">Make space for your next idea.</h1>
      <p class="auth-intro">Sign in to discover new work and reconnect with the creative community.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="auth-error" role="alert"><%= error %></div>
      <% } %>

      <form class="auth-form" action="/login" method="POST">
        <div class="form-block">
          <label for="email">Email or username</label>
          <input type="text" id="email" name="email" placeholder="Email address or username" autocomplete="username" required />
        </div>

        <div class="form-block">
          <div class="auth-label-row">
            <label for="password">Password</label>
            <a href="/forgot-password">Forgot password?</a>
          </div>
          <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required />
        </div>

        <button type="submit" class="btn btn-primary auth-submit">Log in</button>
      </form>

      <p class="auth-register">New to ArtSpace? <a href="/register">Create an account</a></p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
