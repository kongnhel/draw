<%- include('../partials/header') %>

<%
  const heroArtistName = heroArtwork ? (heroArtwork.display_name || heroArtwork.username) : '';
  const heroOwned = Boolean(heroArtwork && isAuthenticated && currentUser && Number(currentUser.id) === Number(heroArtwork.user_id));
  const heroPinned = Boolean(heroArtwork && typeof pinnedIds !== 'undefined' && pinnedIds && pinnedIds.has(Number(heroArtwork.id)));
  const homeArtistCount = new Set(bookArtworks.map((item) => item.username)).size;
  const liveCategoryCount = visibleCategories.filter((category) => Number(category.count) > 0).length;
%>

<div class="hs-page" data-sketch-home>
  <main class="hs-main">

    <section class="hs-hero" data-motion aria-labelledby="hero-title">
      <div class="hs-hero-copy">
        <span class="hs-eyebrow">Cambodian creative community</span>
        <h1 id="hero-title">A living <span>sketchbook.</span></h1>
        <p class="hs-hero-sub">The community sketchbook.</p>
        <p class="hs-lede">Original drawings, paintings, and visual stories — made by artists, kept by the community. Every line begins with a story, and every page is still being written.</p>
        <div class="hs-hero-actions">
          <a href="/explore?sort=latest" class="hs-btn hs-btn-dark">Explore Artwork <span aria-hidden="true">↗</span></a>
          <a href="/upload" class="hs-btn hs-btn-outline">Share Your Drawing <span aria-hidden="true">+</span></a>
        </div>
        <dl class="hs-stats">
          <div>
            <dt>Artworks</dt>
            <dd><%= totalArtworks %></dd>
          </div>
          <div>
            <dt>Artists</dt>
            <dd><%= homeArtistCount %></dd>
          </div>
          <div>
            <dt>Mediums</dt>
            <dd><%= liveCategoryCount %></dd>
          </div>
        </dl>
      </div>

      <div class="hs-hero-art">
        <span class="hs-hero-tape" aria-hidden="true"></span>
        <% if (heroArtwork && heroArtworkImageUrl) { %>
          <%
            const heroSrc = imageTools.transformUrl(heroArtwork.image_url || heroArtworkImageUrl, 720);
            const heroSrcset = imageTools.srcset(heroArtwork.image_url || heroArtworkImageUrl, [320, 480, 720, 960, 1200]);
          %>
          <a href="/art/<%= heroArtwork.id %>" class="hs-feature home-hero-feature" aria-label="View <%= heroArtwork.title %> by <%= heroArtistName %>">
            <span class="hs-feature-mat">
              <img src="<%= heroSrc %>"<% if (heroSrcset) { %> srcset="<%= heroSrcset %>" sizes="(max-width: 480px) 40vw, (max-width: 1080px) 46vw, 480px"<% } %> width="480" height="600" data-home-feature-image data-fallback-src="/images/default-artwork.svg" alt="<%= heroArtwork.title %> by <%= heroArtistName %>" loading="eager" fetchpriority="high" decoding="async">
            </span>
            <span class="hs-feature-meta">
              <span class="hs-feature-kicker">Plate <%= String(heroArtworkIndex).padStart(2, '0') %> · <%= heroArtwork.category_name || 'Original artwork' %></span>
              <strong><%= heroArtwork.title %></strong>
              <span class="hs-feature-artist">by <%= heroArtistName %></span>
            </span>
            <span class="hs-feature-arrow" aria-hidden="true">↗</span>
          </a>
        <% } else { %>
          <a href="/upload" class="hs-feature hs-feature-empty home-hero-feature">
            <span class="hs-feature-mat">
              <svg viewBox="0 0 80 80" aria-hidden="true"><path d="M15 64 26 26l28-10 9 29-23 23-25-2Z" /><path d="m26 26 28 17M36 65l-10-40" /></svg>
            </span>
            <span class="hs-feature-meta">
              <span class="hs-feature-kicker">The first page</span>
              <strong>Waiting for your line.</strong>
              <span class="hs-feature-artist">Upload an artwork to begin</span>
            </span>
            <span class="hs-feature-arrow" aria-hidden="true">↗</span>
          </a>
        <% } %>
        <% if (heroOwned) { %>
          <button type="button" class="hs-hero-pin<%= heroPinned ? ' is-pinned' : '' %>" data-pin-toggle data-pin-label-long data-artwork-id="<%= heroArtwork.id %>" data-pinned="<%= heroPinned ? 'true' : 'false' %>" aria-pressed="<%= heroPinned ? 'true' : 'false' %>" aria-label="<%= heroPinned ? 'Unpin from the homepage' : 'Pin to the homepage' %>" title="<%= heroPinned ? 'Unpin from homepage' : 'Pin to homepage' %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6l-.8 4.6 3 3.1v2.1H6.8v-2.1l3-3.1L9 4Z" /><path d="M12 14v6" /></svg>
            <span data-pin-label><%= heroPinned ? 'Pinned' : 'Pin to homepage' %></span>
          </button>
        <% } %>
        <p class="hs-hero-note"><span aria-hidden="true">✦</span> Every line begins<br>with a story.</p>
      </div>
    </section>

<%
  const collageArtworks = bookArtworks.slice(0, 3);
  const communityArtists = [];
  const seenCommunityArtists = new Set();
  bookArtworks.forEach((artwork) => {
    if (communityArtists.length >= 4 || seenCommunityArtists.has(artwork.username)) return;
    seenCommunityArtists.add(artwork.username);
    communityArtists.push(artwork);
  });
  const collageNotes = ['Artist community', 'Made with creativity', 'Share your art'];
%>

    <section class="hs-book" id="art-book" data-motion aria-labelledby="book-title">
      <span class="hs-book-tape hs-book-tape-a" aria-hidden="true"></span>
      <span class="hs-book-tape hs-book-tape-b" aria-hidden="true"></span>
      <svg class="hs-book-doodle hs-book-doodle-star" viewBox="0 0 60 60" aria-hidden="true"><path d="M30 4c2 12 8 18 20 20-12 2-18 8-20 20-2-12-8-18-20-20 12-2 18-8 20-20Z" /></svg>
      <svg class="hs-book-doodle hs-book-doodle-loop" viewBox="0 0 130 80" aria-hidden="true"><path d="M8 58c18-24 36-30 54-16 14 11 26 10 48-6" /><path d="M96 26c8 4 12 9 14 16" /></svg>

      <div class="hs-book-intro<%= collageArtworks.length ? '' : ' hs-book-intro-solo' %>">
        <div class="hs-book-copy">
          <span class="hs-eyebrow">Turn the pages</span>
          <h2 id="book-title" class="hs-book-title">Inside the<br><span class="hs-book-script">book<span class="hs-book-period">.</span></span></h2>
          <svg class="hs-book-underline" viewBox="0 0 320 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12C58 4 112 4 166 8s105 5 151-3" pathLength="1" /></svg>
          <p class="hs-book-lede">A living collection of drawings, paintings, and visual stories &mdash; made by artists, kept by the community. Turn the pages to meet each original work.</p>
          <div class="hs-book-actions">
            <a class="hs-btn hs-btn-dark" href="/explore?sort=latest">Explore Artwork <span aria-hidden="true">&nearr;</span></a>
            <a class="hs-btn hs-btn-outline" href="/upload">Share Your Drawing <span aria-hidden="true">+</span></a>
          </div>
          <div class="hs-book-community">
            <% if (communityArtists.length) { %>
              <div class="hs-book-avatars">
                <% communityArtists.forEach((artist) => { %>
                  <a class="hs-book-avatar" href="/profile/<%= artist.username %>" aria-label="Visit <%= artist.display_name || artist.username %>'s profile">
                    <img src="<%= artist.avatar || '/uploads/avatars/default-avatar.svg' %>" data-fallback-src="/uploads/avatars/default-avatar.svg" alt="" loading="lazy" decoding="async" />
                  </a>
                <% }) %>
              </div>
            <% } %>
            <p class="hs-book-meta"><strong><%= bookArtworks.length %></strong> <%= bookArtworks.length === 1 ? 'work' : 'works' %> <span>&middot;</span> <strong><%= homeArtistCount %></strong> <%= homeArtistCount === 1 ? 'artist' : 'artists' %> <span>&middot;</span> Vol. 01</p>
          </div>
        </div>

        <% if (collageArtworks.length) { %>
          <div class="hs-book-collage" aria-label="Artwork previews from the community">
            <svg class="hs-book-connect" viewBox="0 0 460 360" preserveAspectRatio="none" aria-hidden="true">
              <path d="M36 312C114 302 138 216 214 202s84-88 168-102" pathLength="1" />
              <path d="M86 96c46 8 66 44 112 54" pathLength="1" />
              <path d="M238 322c54-16 88-40 122-88" pathLength="1" />
            </svg>
            <% collageArtworks.forEach((artwork, index) => { %>
              <%
                const collageSrc = imageTools.cardSrc(artwork, 520);
                const collageSrcset = imageTools.cardSrcset(artwork, [240, 360, 520, 720]);
              %>
              <div class="hs-collage-item hs-collage-item-<%= index + 1 %>">
                <a class="hs-collage-card" href="/art/<%= artwork.id %>" data-artwork-view data-artwork-id="<%= artwork.id %>" data-artwork-full="<%= artwork.image_url || artwork.thumbnail_url %>" data-artwork-thumb="<%= artwork.thumbnail_url || artwork.image_url %>" data-artwork-title="<%= artwork.title %>" data-artwork-description="<%= artwork.description || '' %>" data-artwork-category="<%= artwork.category_name || '' %>" data-artwork-tags="<%= artwork.tags || '' %>" data-artwork-effect="<%= artwork.visual_effect || 'auto' %>" data-artwork-artist="<%= artwork.display_name || artwork.username %>" data-artwork-artist-url="/profile/<%= artwork.username %>" data-artwork-date="<%= artwork.created_at_label || 'Original artwork' %>" data-artwork-liked="<%= artwork.is_liked ? 'true' : 'false' %>" data-artwork-saved="<%= artwork.is_bookmarked ? 'true' : 'false' %>" data-artwork-likes="<%= artwork.likes_count || 0 %>" aria-label="View <%= artwork.title %> by <%= artwork.display_name || artwork.username %>">
                  <span class="hs-collage-tape" aria-hidden="true"></span>
                  <img src="<%= collageSrc %>"<% if (collageSrcset) { %> srcset="<%= collageSrcset %>" sizes="(max-width: 760px) 34vw, 220px"<% } %> width="520" height="650" data-fallback-src="/images/default-artwork.svg" alt="<%= artwork.title %>" loading="lazy" decoding="async" />
                  <span class="hs-collage-meta">
                    <strong><%= artwork.title %></strong>
                    <em>by <%= artwork.display_name || artwork.username %></em>
                  </span>
                  <span class="hs-collage-open" aria-hidden="true">&nearr;</span>
                </a>
                <span class="hs-collage-note hs-collage-note-<%= index + 1 %>"><%= collageNotes[index] %></span>
              </div>
            <% }) %>
            <span class="hs-collage-spark" aria-hidden="true">&#10022;</span>
          </div>
        <% } %>
      </div>

      <% if (bookArtworks.length) { %>
        <div class="hs-book-shell">
          <span class="hs-book-shell-tape" aria-hidden="true"></span>
          <span class="hs-book-ribbon" aria-hidden="true"></span>
          <svg class="hs-book-pencil" viewBox="0 0 220 64" aria-hidden="true">
            <g transform="rotate(-12 110 32)">
              <path d="M18 25h22v14H18z" fill="#b06a52" stroke="#5d2d22" stroke-width="1" />
              <path d="M40 23h12v18H40z" fill="#b9b4a8" stroke="#6f6a5e" stroke-width="1" />
              <path d="M52 20h118l14 12-14 12H52z" fill="#4a473f" stroke="#292824" stroke-width="1.3" />
              <path d="M170 20l26 12-26 12 4-12z" fill="#e0bb87" stroke="#8a6b45" stroke-width="1" />
              <path d="M196 29l14 3-14 3z" fill="#2e2c28" />
              <path d="M56 24h108M56 40h108" stroke="#6b675e" stroke-width="1" />
            </g>
          </svg>

          <div class="book-experience" data-art-book data-artwork-count="<%= bookArtworks.length %>">
            <div class="book-stage">
              <div class="art-book" data-book-root role="region" aria-label="ArtSpace community art book" tabindex="0">
                <article class="book-page book-cover" data-book-page data-density="hard">
                  <div class="book-cover-design">
                    <span class="book-cover-mark">ARTSPACE <span>COMMUNITY EDITION</span></span>
                    <span class="book-cover-ornament" aria-hidden="true">A</span>
                    <span class="book-cover-title">The Art<br />Book</span>
                    <span class="book-cover-note"><%= bookArtworks.length %> original <%= bookArtworks.length === 1 ? 'work' : 'works' %><br />from a creative community</span>
                    <span class="book-cover-year">VOL. 01 &nbsp; | &nbsp; CAMBODIA &amp; BEYOND</span>
                  </div>
                </article>
                <% bookArtworks.forEach((artwork, index) => { %>
                  <article class="book-page" data-book-page data-artwork-view data-artwork-id="<%= artwork.id %>" data-artwork-full="<%= artwork.image_url %>" data-artwork-thumb="<%= artwork.thumbnail_url || artwork.image_url %>" data-artwork-title="<%= artwork.title %>" data-artwork-description="<%= artwork.description || '' %>" data-artwork-category="<%= artwork.category_name || '' %>" data-artwork-tags="<%= artwork.tags || '' %>" data-artwork-effect="<%= artwork.visual_effect || 'auto' %>" data-artwork-artist="<%= artwork.display_name || artwork.username %>" data-artwork-artist-url="/profile/<%= artwork.username %>" data-artwork-date="<%= artwork.created_at_label %>" data-artwork-liked="<%= artwork.is_liked ? 'true' : 'false' %>" data-artwork-saved="<%= artwork.is_bookmarked ? 'true' : 'false' %>" data-artwork-likes="<%= artwork.likes_count || 0 %>">
                    <div class="book-page-content">
                      <a class="book-artwork-link" href="/art/<%= artwork.id %>" aria-label="View <%= artwork.title %> by <%= artwork.display_name || artwork.username %>">
                        <img data-book-image data-src="<%= artwork.thumbnail_url || artwork.image_url %>" data-fallback-src="<%= artwork.image_url || '' %>" alt="<%= artwork.title %>" loading="lazy" decoding="async" />
                        <span class="book-image-placeholder" aria-hidden="true"><strong><%= artwork.title %></strong><span>Artwork image unavailable</span></span>
                      </a>
                      <div class="book-page-details">
                        <div class="book-page-heading">
                          <span class="book-category"><%= artwork.category_name || 'Original artwork' %></span>
                          <time><%= artwork.created_at_label %></time>
                        </div>
                        <a class="book-artwork-title" href="/art/<%= artwork.id %>"><%= artwork.title %></a>
                        <span class="book-artwork-artist">by <%= artwork.display_name || artwork.username %></span>
                        <span class="book-page-number"><%= String(index + 1).padStart(2, '0') %></span>
                      </div>
                    </div>
                  </article>
                <% }) %>
              </div>
            </div>
            <div class="book-controls">
              <div class="book-progress">
                <span class="book-page-counter" data-book-current aria-live="polite">Cover</span>
                <span class="book-counter-divider">/</span>
                <span class="book-page-total" data-book-total><%= String(bookArtworks.length).padStart(2, '0') %></span>
              </div>
              <p class="book-current-work" data-book-live aria-live="polite">Turn the cover to explore the collection.</p>
              <div class="book-navigation">
                <button class="book-nav-button book-close-button" type="button" data-book-close aria-label="Close book" title="Close book" hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
                <button class="book-nav-button" type="button" data-book-prev aria-label="Turn to previous page" title="Previous page" disabled>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                </button>
                <button class="book-nav-button" type="button" data-book-next aria-label="Turn to next page" title="Next page">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                </button>
              </div>
            </div>
          </div>
          <p class="hs-book-tip" aria-hidden="true"><span>&#8627;</span> turn the page, or tap an artwork to open it</p>
        </div>
      <% } else { %>
        <div class="book-empty-state">
          <div class="book-empty-object" aria-hidden="true"><span></span><span></span></div>
          <span class="sketch-eyebrow">A new collection begins</span>
          <h3>The first page is still waiting.</h3>
          <p>Be the first to add an artwork to the community book.</p>
          <a href="/upload" class="hs-btn hs-btn-dark">Share Your Drawing <span aria-hidden="true">&nearr;</span></a>
        </div>
      <% } %>
    </section>

    <section class="hs-pinned" data-pinned-collection data-motion aria-labelledby="pinned-title">
      <div class="hs-section-head hs-pinned-head">
        <div class="hs-section-title">
          <span class="hs-eyebrow">The pinboard</span>
          <h2 id="pinned-title">Pinned <em>sketches.</em></h2>
        </div>
        <div class="hs-section-aside">
          <p>Little masterpieces worth remembering — pinned by the artists themselves.</p>
          <% if (pinnedArtworks.length) { %>
            <span class="hs-book-count"><%= pinnedArtworks.length %> latest <%= pinnedArtworks.length === 1 ? 'pin' : 'pins' %></span>
          <% } %>
        </div>
      </div>

      <% if (pinnedArtworks.length) { %>
        <div class="hs-pinned-grid">
          <% pinnedArtworks.forEach((artwork, index) => { %>
            <%- include('../partials/pinned-card', { artwork, index }) %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="hs-pinned-empty">
          <svg class="hs-pinned-empty-pin" viewBox="0 0 70 80" aria-hidden="true">
            <path d="M22 10h26l-3 18 12 12v8H13v-8l12-12-3-18Z" />
            <path d="M35 48v24" />
            <path d="M18 72c12-4 23-4 34 0" />
          </svg>
          <span class="hs-eyebrow">A quiet pinboard</span>
          <h3>No pinned sketches yet.</h3>
          <p>Upload a drawing, then pin it to the top of the community sketchbook for everyone to see.</p>
          <a href="/upload" class="hs-btn hs-btn-dark">Share Your Drawing <span aria-hidden="true">&nearr;</span></a>
        </div>
      <% } %>
    </section>

    <% if (typeof journeyArtworks !== 'undefined' && journeyArtworks.length > 1) { %>
    <section class="hs-journey" id="sketch-journey" data-motion aria-labelledby="journey-title">
      <div class="hs-section-head">
        <div class="hs-section-title">
          <span class="hs-eyebrow">The connected sketchbook</span>
          <h2 id="journey-title">Follow the <em>line.</em></h2>
        </div>
        <div class="hs-section-aside">
          <p>One drawing leads to another. Trace the pencil through the works the community loves most.</p>
          <a href="/explore?sort=popular" class="hs-link">Explore the collection <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hs-journey-track" data-home-journey aria-label="Connected artwork journey">
        <svg class="sketch-journey-lines" aria-hidden="true" focusable="false"></svg>
        <% journeyArtworks.forEach((artwork, index) => { %>
          <%- include('../partials/journey-card', { artwork, index }) %>
        <% }) %>
      </div>
      <p class="hs-journey-tip" aria-hidden="true"><span>↳</span> follow the pencil from page to page</p>
    </section>
    <% } %>

    <section class="hs-wall" data-motion aria-labelledby="wall-title">
      <div class="hs-section-head">
        <div class="hs-section-title">
          <span class="hs-eyebrow">Fresh from the studio</span>
          <h2 id="wall-title">Recently <em>added.</em></h2>
        </div>
        <div class="hs-section-aside">
          <p>New lines, new ideas, and new pages from the community.</p>
          <a href="/explore?sort=latest" class="hs-link">View all artwork <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <% if (latest.length) { %>
        <div class="hs-wall-grid">
          <% latest.slice(0, 9).forEach((artwork) => { %>
            <%- include('../partials/art-card', { artwork }) %>
          <% }) %>
        </div>
      <% } else { %>
        <p class="hs-empty">New work will appear here as soon as it is shared.</p>
      <% } %>
    </section>

    <section class="hs-artist" id="artist-spotlight" data-motion aria-labelledby="artist-title">
      <div class="hs-section-head">
        <div class="hs-section-title">
          <span class="hs-eyebrow"><%= artistSpotlight ? 'Artist in focus' : 'Made for artists' %></span>
          <h2 id="artist-title">A real workspace<br>for <em>real work.</em></h2>
        </div>
      </div>
      <% if (artistSpotlight) { %>
        <div class="hs-artist-card">
          <span class="hs-artist-quote" aria-hidden="true">“</span>
          <div class="hs-artist-portrait">
            <img src="<%= artistSpotlight.avatar || '/uploads/avatars/default-avatar.svg' %>" alt="<%= artistSpotlight.display_name || artistSpotlight.username %>" loading="lazy">
            <span class="hs-artist-sticker">Artist<br>in focus</span>
          </div>
          <div class="hs-artist-copy">
            <h3><%= artistSpotlight.display_name || artistSpotlight.username %></h3>
            <blockquote><%= artistSpotlight.bio || 'Part of a growing community sharing original drawings, paintings, and visual stories.' %></blockquote>
            <div class="hs-artist-meta">
              <span class="hs-artist-count"><strong><%= artistSpotlight.art_count || 0 %></strong> <%= Number(artistSpotlight.art_count) === 1 ? 'work' : 'works' %> in the collection</span>
              <a href="/profile/<%= artistSpotlight.username %>" class="hs-link">Visit artist profile <span aria-hidden="true">↗</span></a>
            </div>
            <% if (typeof artistSpotlightArtworks !== 'undefined' && artistSpotlightArtworks.length) { %>
              <div class="hs-artist-previews" aria-label="Artwork by <%= artistSpotlight.display_name || artistSpotlight.username %>">
                <% artistSpotlightArtworks.forEach((artwork) => { %>
                  <%
                    const previewSrc = imageTools.cardSrc(artwork, 320);
                    const previewSrcset = imageTools.cardSrcset(artwork, [160, 240, 320, 480]);
                  %>
                  <a class="hs-artist-preview" href="/art/<%= artwork.id %>" data-artwork-view data-artwork-id="<%= artwork.id %>" data-artwork-full="<%= artwork.image_url || artwork.thumbnail_url %>" data-artwork-thumb="<%= artwork.thumbnail_url || artwork.image_url %>" data-artwork-title="<%= artwork.title %>" data-artwork-description="<%= artwork.description || '' %>" data-artwork-category="<%= artwork.category_name || '' %>" data-artwork-tags="<%= artwork.tags || '' %>" data-artwork-effect="<%= artwork.visual_effect || 'auto' %>" data-artwork-artist="<%= artwork.display_name || artwork.username %>" data-artwork-artist-url="/profile/<%= artwork.username %>" data-artwork-date="<%= artwork.created_at_label || 'Original artwork' %>" data-artwork-liked="<%= artwork.is_liked ? 'true' : 'false' %>" data-artwork-saved="<%= artwork.is_bookmarked ? 'true' : 'false' %>" data-artwork-likes="<%= artwork.likes_count || 0 %>" aria-label="View <%= artwork.title %>">
                    <img src="<%= previewSrc %>"<% if (previewSrcset) { %> srcset="<%= previewSrcset %>" sizes="(max-width: 640px) 28vw, 140px"<% } %> width="320" height="400" data-fallback-src="/images/default-artwork.svg" alt="<%= artwork.title %>" loading="lazy" decoding="async" />
                  </a>
                <% }) %>
                <a class="hs-artist-previews-more" href="/profile/<%= artistSpotlight.username %>">See the full collection <span aria-hidden="true">↗</span></a>
              </div>
            <% } %>
          </div>
        </div>
      <% } else { %>
        <div class="hs-artist-card hs-artist-card-empty">
          <div class="hs-artist-copy">
            <h3>Every artist has a first page.</h3>
            <p>ArtSpace is a home for original work and the people who make it.</p>
            <a href="/register" class="hs-btn hs-btn-dark">Join the community <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      <% } %>
    </section>

    <section class="hs-categories" data-motion aria-labelledby="cats-title">
      <div class="hs-section-head">
        <div class="hs-section-title">
          <span class="hs-eyebrow">Creative categories</span>
          <h2 id="cats-title">Where ideas <em>live.</em></h2>
        </div>
        <div class="hs-section-aside">
          <p>Browse the collection by medium, mood, and way of making.</p>
          <a href="/explore" class="hs-link">See all artwork <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hs-category-index">
        <% visibleCategories.forEach((category, index) => { %>
          <a class="hs-category-row <%= Number(category.count) > 0 ? 'is-live' : 'is-empty' %>" href="/explore?category=<%= category.slug %>">
            <span class="hs-cat-num"><%= String(index + 1).padStart(2, '0') %></span>
            <span class="hs-cat-icon" aria-hidden="true">
              <% if (category.slug === 'pencil-drawing') { %>
                <svg viewBox="0 0 24 24"><path d="M5 19l2.2 3.6L11 20l7-12-4-3-8 12zM15 5l2 2" /></svg>
              <% } else if (category.slug === 'portrait-drawing') { %>
                <svg viewBox="0 0 24 24"><path d="M12 5a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm6 14c-2-3-7-3-9 0" /></svg>
              <% } else if (category.slug === 'digital-art') { %>
                <svg viewBox="0 0 24 24"><path d="M6 6h12v12H6z" /><path d="M10 10h4v4h-4z" /></svg>
              <% } else if (category.slug === 'character-design') { %>
                <svg viewBox="0 0 24 24"><path d="M6 18c1-4 3-7 6-7s5 3 6 7" /><path d="M12 6a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z" /></svg>
              <% } else if (category.slug === 'anime-manga') { %>
                <svg viewBox="0 0 24 24"><path d="M4 17c2-6 4-10 8-11 4-1 6 4 8 8" /><path d="M6 12h12" /></svg>
              <% } else if (category.slug === 'sketching') { %>
                <svg viewBox="0 0 24 24"><path d="M6 17c1-4 3-8 6-11 3 3 5 7 6 11" /></svg>
              <% } else if (category.slug === 'watercolor' || category.slug === 'oil-painting') { %>
                <svg viewBox="0 0 24 24"><path d="M4 10h16v8H4z" /><path d="M6 14h4m4 0h4" /></svg>
              <% } else if (category.slug === 'landscape-drawing') { %>
                <svg viewBox="0 0 24 24"><path d="M4 18h16l-5-7-4 5-2-3z" /></svg>
              <% } else if (category.slug === 'abstract-art') { %>
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7" /><path d="M9 9h6v6H9z" /></svg>
              <% } else if (category.slug === '3d-art') { %>
                <svg viewBox="0 0 24 24"><path d="M6 18h12l-3-9H9z" /></svg>
              <% } else { %>
                <svg viewBox="0 0 24 24"><path d="M5 18h14l-3-8h-8z" /></svg>
              <% } %>
            </span>
            <span class="hs-cat-name"><%= category.name %></span>
            <span class="hs-cat-count"><%= category.count %> <%= category.count === 1 ? 'work' : 'works' %></span>
            <span class="hs-cat-arrow" aria-hidden="true">↗</span>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="hs-final" data-motion>
      <div class="hs-final-poster">
        <span class="hs-eyebrow">The sketchbook never closes</span>
        <h2>Every sketch<br>tells a <em>story.</em></h2>
        <p>Share your creativity, discover new perspectives, and become part of our growing art community.</p>
        <div class="hs-final-actions">
          <a href="<%= isAuthenticated ? '/upload' : '/register' %>" class="hs-btn hs-btn-light">Start Your Sketchbook <span aria-hidden="true">↗</span></a>
          <a href="/explore" class="hs-link hs-link-light">Explore the gallery <span aria-hidden="true">↗</span></a>
        </div>
        <svg class="hs-final-doodle" viewBox="0 0 240 200" fill="none" aria-hidden="true">
          <path d="M40 150c40-16 74-48 96-92l18 10c-20 46-54 80-98 96l-16-14Z" />
          <path d="m136 58 18 10M52 142l18 10M134 146c30-6 58-2 84 12" />
          <circle cx="182" cy="46" r="26" />
          <path d="M170 32c8 2 14 8 16 16" />
        </svg>
      </div>
    </section>

  </main>
</div>

<%- include('../partials/footer') %>
