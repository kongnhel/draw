<%- include('../partials/header') %>

<%
  const notebookArtworks = bookArtworks || [];
  const currentYear = new Date().getFullYear();
  const homeTotalWorks = Number(totalArtworks) || notebookArtworks.length;
  const sliderArtworks = (bookArtworks || []).map((artwork) => ({
    src: imageTools.transformUrl(artwork.image_url || artwork.thumbnail_url, 900),
    title: artwork.title,
    artist: artwork.display_name || artwork.username,
    medium: artwork.category_name || 'Original artwork',
    year: artwork.created_at ? new Date(artwork.created_at).getFullYear() : ''
  }));
%>

<div class="nb-home" data-sketch-home>
  <main class="nb-main">

    <section class="nb-notebook" data-motion aria-labelledby="nb-title">
      <span class="nb-spine" aria-hidden="true"></span>
      <span class="nb-page-stack nb-page-stack--one" aria-hidden="true"></span>
      <span class="nb-page-stack nb-page-stack--two" aria-hidden="true"></span>

      <div class="nb-sheet">
        <svg class="nb-doodle nb-doodle--pencil" viewBox="0 0 120 120" aria-hidden="true">
          <path d="m20 92 8-30 51-51c4-4 9-4 13 0l9 9c4 4 4 9 0 13L50 84l-30 8Z" />
          <path d="m28 62 18 18M79 24l18 18M20 92l-3 11 11-3M92 39l-7 8M36 74l18 18" />
        </svg>
        <svg class="nb-doodle nb-doodle--star" viewBox="0 0 70 70" aria-hidden="true">
          <path d="M35 6c0 16-13 29-29 29 16 0 29 13 29 29 0-16 13-29 29-29-16 0-29-13-29-29Z" />
        </svg>
        <svg class="nb-doodle nb-doodle--loop" viewBox="0 0 190 90" aria-hidden="true">
          <path d="M8 71c33 4 64 2 94-8 26-9 48-22 68-39M142 19c9-4 18-4 27 0" />
        </svg>

        <header class="nb-masthead">
          <div class="nb-masthead-line">
            <span class="nb-brand">ArtSpace <span>/</span> The community sketchbook</span>
            <span class="nb-volume">Vol. 01 <span>·</span> <%= currentYear %></span>
          </div>

          <div class="nb-intro">
            <div class="nb-intro-copy">
              <span class="nb-kicker">Made by hand <span>·</span> kept by the community</span>
              <h1 id="nb-title">A living <em>sketchbook.</em></h1>
              <p class="nb-lede">Original drawings, paintings, and visual stories, placed page by page by the people who make them. Every line begins with a story, and every page is still being written.</p>
              <div class="nb-actions">
                <a href="/explore?sort=latest" class="nb-btn nb-btn--ink">Explore the pages <span aria-hidden="true">↗</span></a>
                <a href="<%= isAuthenticated ? '/upload' : '/register' %>" class="nb-btn nb-btn--paper">Add your drawing <span aria-hidden="true">+</span></a>
              </div>
              <p class="nb-hand-note"><span aria-hidden="true">✦</span> Turn the page gently. Someone left a little of themselves here.</p>
            </div>

            <dl class="nb-ledger" aria-label="Sketchbook statistics">
              <div>
                <dt>Pages</dt>
                <dd><%= homeTotalWorks %></dd>
              </div>
              <div>
                <dt>Artists</dt>
                <dd><%= homeArtistCount %></dd>
              </div>
              <div>
                <dt>Mediums</dt>
                <dd><%= liveCategoryCount %></dd>
              </div>
              <span class="nb-ledger-stamp" aria-hidden="true">open<br>book</span>
            </dl>
          </div>

          <nav class="nb-tabs" aria-label="Browse artwork by medium">
            <span class="nb-tabs-label">Browse the pages</span>
            <div class="nb-tabs-track">
              <a href="/explore?sort=latest" class="is-active" aria-current="page">All work <sup><%= homeTotalWorks %></sup></a>
              <% visibleCategories.filter((category) => Number(category.count) > 0).forEach((category) => { %>
                <a href="/explore?category=<%= encodeURIComponent(category.slug) %>">
                  <%= category.name %> <sup><%= category.count %></sup>
                </a>
              <% }) %>
            </div>
          </nav>
        </header>

        <section class="nb-gallery" aria-labelledby="nb-gallery-title">
          <div class="nb-gallery-head">
            <div>
              <span class="nb-kicker">01 <span>/</span> The community wall</span>
              <h2 id="nb-gallery-title">Drawn by <em>hand.</em></h2>
            </div>
            <p>
              A growing collection of originals, sketches, and studies.
              <% if (notebookArtworks.length) { %>
                <strong><%= notebookArtworks.length %></strong> pages pinned to this book.
              <% } %>
            </p>
          </div>

          <% if (notebookArtworks.length) { %>
            <div class="nb-art-grid">
              <% notebookArtworks.forEach((artwork, index) => { %>
                <%- include('../partials/notebook-art', { artwork, index }) %>
              <% }) %>
            </div>
            <div class="nb-gallery-foot">
              <span class="nb-hand-note"><span aria-hidden="true">↳</span> each page is an original, kept exactly as it was made</span>
              <a href="/explore?sort=latest" class="nb-link">See the full collection <span aria-hidden="true">↗</span></a>
            </div>
          <% } else { %>
            <div class="nb-empty">
              <span class="nb-kicker">A new sketchbook</span>
              <h3>The first page is still waiting.</h3>
              <p>Be the first to leave a drawing in the community book.</p>
              <a href="/upload" class="nb-btn nb-btn--ink">Share your drawing <span aria-hidden="true">↗</span></a>
            </div>
          <% } %>
        </section>

        <% if (artistSpotlight) { %>
          <aside class="nb-artist-note" aria-labelledby="nb-artist-title">
            <span class="nb-artist-tape" aria-hidden="true"></span>
            <a class="nb-artist-avatar" href="/profile/<%= artistSpotlight.username %>" aria-label="Visit <%= artistSpotlight.display_name || artistSpotlight.username %>'s profile">
              <img src="<%= artistSpotlight.avatar || '/images/default-avatar.svg' %>" data-fallback-src="/images/default-avatar.svg" alt="<%= artistSpotlight.display_name || artistSpotlight.username %>" loading="lazy" data-i18n-skip>
            </a>
            <div class="nb-artist-copy">
              <span class="nb-kicker">02 <span>/</span> The hand behind the pages</span>
              <h2 id="nb-artist-title" data-i18n-skip><%= artistSpotlight.display_name || artistSpotlight.username %></h2>
              <p<%- artistSpotlight.bio && artistSpotlight.bio.trim() ? ' data-i18n-skip' : '' %>><%= artistSpotlight.bio || 'Part of a growing community sharing original drawings, paintings, and visual stories.' %></p>
              <a href="/profile/<%= artistSpotlight.username %>" class="nb-link">Visit the artist's studio <span aria-hidden="true">↗</span></a>
            </div>
            <div class="nb-artist-stat" aria-label="<%= artistSpotlight.art_count || 0 %> works in the collection">
              <strong><%= artistSpotlight.art_count || 0 %></strong>
              <span><%= Number(artistSpotlight.art_count) === 1 ? 'page' : 'pages' %> in this book</span>
            </div>
          </aside>
        <% } %>

        <section class="nb-cta" aria-labelledby="nb-cta-title">
          <span class="nb-kicker">03 <span>/</span> Keep the pencil moving</span>
          <h2 id="nb-cta-title">Your next page<br>is <em>waiting.</em></h2>
          <p>Share a sketch, a study, or the line you cannot stop thinking about. Someone out there is looking for exactly what you make.</p>
          <div class="nb-actions">
            <a href="<%= isAuthenticated ? '/upload' : '/register' %>" class="nb-btn nb-btn--ink"><%= isAuthenticated ? 'Start a new page' : 'Join the sketchbook' %> <span aria-hidden="true">↗</span></a>
            <a href="/explore" class="nb-link">Explore the gallery <span aria-hidden="true">→</span></a>
          </div>
          <svg class="nb-cta-doodle" viewBox="0 0 200 150" aria-hidden="true">
            <path d="M22 115c29-13 53-37 69-70l14 8c-15 35-40 61-73 73l-10-11Z" />
            <path d="m93 49 14 8M36 105l14 8M88 115c25-4 47 0 68 12" />
            <circle cx="153" cy="31" r="19" />
            <path d="M143 19c6 2 10 6 12 12" />
          </svg>
        </section>

        <span class="nb-page-number" aria-hidden="true">01</span>
      </div>
    </section>

    <%- include('../partials/ad-unit', { slot: adsenseSlots.home, className: 'ad-unit--home' }) %>

    <% if (sliderArtworks.length) { %>
      <section class="nb-turn" id="art-book" data-motion aria-labelledby="nb-turn-title">
        <div class="nb-turn-copy">
          <div class="nb-turn-title">
            <span class="nb-kicker">The page-by-page edition</span>
            <h2 id="nb-turn-title">Turn the <em>pages.</em></h2>
          </div>
          <p>Prefer a slower read? Open the same collection as a page-turn sketchbook.</p>
        </div>
        <%- include('../partials/book-slider', { artworks: sliderArtworks }) %>
      </section>
    <% } %>

  </main>
</div>

<%- include('../partials/footer') %>
