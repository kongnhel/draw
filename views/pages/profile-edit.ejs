<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1>Edit profile</h1>
    <div class="page-subtitle">Refine your bio and social links.</div>
  </div>
</div>

<div class="form-card" style="max-width: 720px; margin: 0 auto;">
  <form action="/profile/edit" method="POST" enctype="multipart/form-data">
    <div class="form-grid">
      <div class="form-block">
        <label for="avatar">Profile image</label>
        <input id="avatar" name="avatar" type="file" accept="image/png, image/jpeg, image/webp" />
      </div>

      <div class="form-block">
        <label for="cover_image">Cover image</label>
        <input id="cover_image" name="cover_image" type="file" accept="image/png, image/jpeg, image/webp" />
      </div>
    </div>

    <div class="form-block">
      <label for="bio">Bio</label>
      <textarea id="bio" name="bio" rows="5" placeholder="Tell the community what inspires your art."><%= user.bio || '' %></textarea>
    </div>

    <div class="form-grid">
      <div class="form-block">
        <label for="website">Website</label>
        <input id="website" name="website" type="url" value="<%= user.website || '' %>" />
      </div>

      <div class="form-block">
        <label for="instagram">Instagram</label>
        <input id="instagram" name="instagram" type="text" value="<%= user.instagram || '' %>" />
      </div>
    </div>

    <div class="form-block">
      <label for="twitter">Twitter</label>
      <input id="twitter" name="twitter" type="text" value="<%= user.twitter || '' %>" />
    </div>

    <div class="submit-row">
      <button type="submit" class="btn btn-primary">Save changes</button>
      <a href="/profile/<%= currentUser.username %>" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
