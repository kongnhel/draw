<%- include('../partials/header') %>

<section class="auth-page" aria-labelledby="register-title">
  <div class="auth-frame">
    <div class="auth-visual">
      <img class="auth-visual-image" src="https://images.unsplash.com/photo-1452860606245-08befc0ff44b?auto=format&fit=crop&w=1400&q=85" alt="Paintbrushes and paints in an artist studio" />
      <span class="auth-grain" aria-hidden="true"></span>
      <span class="auth-tape auth-tape-left" aria-hidden="true"></span>
      <span class="auth-tape auth-tape-right" aria-hidden="true"></span>
      <span class="auth-watermark" aria-hidden="true"></span>

      <div class="auth-stamps" aria-hidden="true">
        <span class="auth-stamp"><span class="auth-stamp-dot"></span>Open studio</span>
        <span class="auth-stamp">Phnom Penh</span>
      </div>

      <%- include('../partials/auth-logo') %>

      <div class="auth-visual-copy">
        <span class="auth-kicker">ARTSPACE / YOUR STUDIO</span>
        <p>Make room for what you imagine.</p>
        <span class="auth-caption">Build your artist profile and share what you create.</span>
      </div>
    </div>

    <div class="auth-content">
      <div class="auth-content-head">
        <a class="auth-back" href="/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m5-5-5 5 5 5" /></svg>
          Back to gallery
        </a>
        <span class="auth-mode">No. 02 · Join</span>
      </div>

      <p class="auth-eyebrow">JOIN THE COMMUNITY</p>
      <h1 id="register-title">Create your artist profile.</h1>
      <svg class="auth-title-underline" viewBox="0 0 240 14" aria-hidden="true"><path pathLength="1" d="M3 9C49 3 108 3 156 6s58 4 81 1" /></svg>
      <p class="auth-intro">A place to share your work, find inspiration, and connect with artists.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="auth-error" role="alert">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5v5.4M12 16.4v.2" /></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form class="auth-form" action="/register" method="POST">
        <div class="form-grid">
          <div class="form-block">
            <label for="username">Username</label>
            <span class="auth-field">
              <svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.2" r="3.4" /><path d="M5.4 19.6c.6-3.4 3.2-5.1 6.6-5.1s6 1.7 6.6 5.1" /></svg>
              <input type="text" id="username" name="username" placeholder="e.g. sokha_art" autocomplete="username" required />
            </span>
          </div>

          <div class="form-block">
            <label for="display_name">Display name</label>
            <span class="auth-field">
              <svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 1.5-5L16.8 3.7l4.5 4.5L10 19.5 4 20Z" /><path d="M13.8 6.7 17.3 10.2" /></svg>
              <input type="text" id="display_name" name="display_name" placeholder="Your public name" autocomplete="name" />
            </span>
          </div>
        </div>

        <div class="form-block">
          <label for="email">Email</label>
          <span class="auth-field">
            <svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="m4.6 7.2 7.4 5.8 7.4-5.8" /></svg>
            <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required />
          </span>
        </div>

        <div class="form-block">
          <label for="password">Password</label>
          <span class="auth-field is-password">
            <svg class="auth-field-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.2" width="14" height="9.6" rx="2" /><path d="M8.6 10.2V7.6a3.4 3.4 0 0 1 6.8 0v2.6M12 13.8v2.2" /></svg>
            <input type="password" id="password" name="password" placeholder="At least 6 characters" minlength="6" autocomplete="new-password" required />
            <button class="auth-password-toggle" type="button" data-password-toggle aria-label="Show password" aria-pressed="false">
              <svg class="auth-eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.4-5.4 9.5-5.4S21.5 12 21.5 12s-3.4 5.4-9.5 5.4S2.5 12 2.5 12Z" /><circle cx="12" cy="12" r="2.6" /></svg>
              <svg class="auth-eye-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4.5 20 20.5M9.6 6.9A10.9 10.9 0 0 1 12 6.6c6.1 0 9.5 5.4 9.5 5.4a17.4 17.4 0 0 1-2.8 3.4M6.2 8.2A17.7 17.7 0 0 0 2.5 12s3.4 5.4 9.5 5.4a10 10 0 0 0 4.1-.9M10.3 10.2a2.6 2.6 0 0 0 3.5 3.6" /></svg>
            </button>
          </span>
        </div>

        <button type="submit" class="btn btn-primary auth-submit">
          <span>Create account</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg>
        </button>
      </form>

      <p class="auth-note">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5.5" y="10.5" width="13" height="9" rx="2" /><path d="M8.8 10.5V8a3.2 3.2 0 0 1 6.4 0v2.5" /></svg>
        Free to join. Your work always remains yours.
      </p>

      <p class="auth-register">Already part of the community? <a href="/login">Log in</a></p>
    </div>
  </div>
</section>

<script src="/js/auth.js?v=<%= assetVersion %>" defer></script>

<%- include('../partials/footer') %>
