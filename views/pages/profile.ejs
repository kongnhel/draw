<%- include('../partials/header') %>

<%
  const memberSince = typeof memberSinceLabel !== 'undefined' ? memberSinceLabel : '';
  const canFollow = isAuthenticated && currentUser.id !== profileUser.id;
  const isOwner = isAuthenticated && currentUser.id === profileUser.id;
  const latest = artworks[0] || null;
  const profileUrl = '/profile/' + profileUser.username;
  const numeral = (v) => Number(v || 0).toLocaleString('en-US');
  const pinnedItems = typeof pinnedArtworks !== 'undefined' && pinnedArtworks ? pinnedArtworks : [];
  const portfolioItems = activeTab === 'liked'
    ? likedArtworks
    : activeTab === 'saved'
      ? savedArtworks
      : activeTab === 'pinned'
        ? pinnedItems
        : artworks;
  const portfolioCount = activeTab === 'artworks' ? stats.totalArtworks : portfolioItems.length;
  const categoryMap = new Map();
  portfolioItems.forEach((artwork) => {
    const name = (artwork.category_name || 'Uncategorised').trim();
    categoryMap.set(name, (categoryMap.get(name) || 0) + 1);
  });
  const portfolioCategories = Array.from(categoryMap, ([name, count]) => ({ name, count }));
  const collectionKicker = activeTab === 'liked'
    ? 'Inspiration board'
    : activeTab === 'saved'
      ? 'Private clippings'
      : activeTab === 'pinned'
        ? 'Featured pinboard'
        : 'The sketchbook';
  const collectionTitle = activeTab === 'liked'
    ? 'Liked Artworks'
    : activeTab === 'saved'
      ? 'Saved Artworks'
      : activeTab === 'pinned'
        ? 'My Pinned Artwork'
        : isOwner
          ? 'My Art Collection'
          : 'Art Collection';
  const collectionBlurb = activeTab === 'liked'
    ? (isOwner
      ? 'Pieces that caught your eye, pinned here for another look.'
      : `Pieces that caught ${profileUser.display_name}'s eye, pinned here for another look.`)
    : activeTab === 'saved'
      ? 'Pages saved for quiet inspiration, tucked away until you need them.'
      : activeTab === 'pinned'
        ? 'Your favourite pages, pinned to the top of the community sketchbook.'
        : isOwner
          ? 'Every page here is an original thought — drawn, kept, and pinned for you.'
          : `Original pages from ${profileUser.display_name}'s ongoing sketchbook.`;
  const collectionCountLabel = activeTab === 'liked'
    ? `${numeral(portfolioCount)} ${portfolioCount === 1 ? 'inspiration' : 'inspirations'} pinned`
    : activeTab === 'saved'
      ? `${numeral(portfolioCount)} ${portfolioCount === 1 ? 'page' : 'pages'} tucked away`
      : activeTab === 'pinned'
        ? `${numeral(portfolioCount)} of ${pinLimit} pinned`
        : `${numeral(portfolioCount)} ${portfolioCount === 1 ? 'piece' : 'pieces'} pinned`;
  const emptyKicker = activeTab === 'liked'
    ? 'The inspiration page'
    : activeTab === 'saved'
      ? 'The clippings folder'
      : activeTab === 'pinned'
        ? 'The pinboard'
        : 'A fresh page';
  const emptyTitle = activeTab === 'liked'
    ? 'No liked artwork yet.'
    : activeTab === 'saved'
      ? 'Nothing saved yet.'
      : activeTab === 'pinned'
        ? 'Nothing pinned yet.'
        : 'No artwork yet.';
  const emptyMessage = activeTab === 'liked'
    ? 'When a drawing catches your eye, it will be pinned here for another look.'
    : activeTab === 'saved'
      ? 'Save the pages that stay with you and they will wait here, ready when inspiration calls.'
      : activeTab === 'pinned'
        ? `Pin up to ${pinLimit} of your own artworks to feature them on the homepage.`
        : isOwner
          ? 'Your sketchbook is open and waiting. Pin the first page of your collection.'
          : 'When this artist shares a new drawing, it will appear here.';
%>

<div class="pf-page">

  <% if (typeof deletedNotice !== 'undefined' && deletedNotice && isOwner) { %>
    <div class="pf-flash" role="status" data-profile-flash>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
      <p><strong>Artwork deleted.</strong> The page has been removed from your collection.</p>
      <button type="button" class="pf-flash-close" data-profile-flash-close aria-label="Dismiss message">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </div>
  <% } %>

  <!-- ============ Hero / cover ============ -->
  <header class="pf-hero">
    <div class="pf-cover" role="img" aria-label="Cover artwork for <%= profileUser.display_name %>" style="background-image: url('<%= profileUser.cover_image || '/uploads/covers/default-cover.svg' %>')">
      <div class="pf-cover-shade" aria-hidden="true"></div>
      <span class="pf-cover-kicker">FIELD NOTES <em>NO. <%= String(profileUser.id).padStart(2, '0') %></em></span>
      <% if (profileUser.is_verified) { %>
        <span class="pf-verified" title="Verified ArtSpace artist">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.5 2.3 3.2-.4 1.5 2.9 3 1.2-1.2 3 1.2 3-3 1.2-1.5 2.9-3.2-.4L12 21.5 9.5 19.2l-3.2.4-1.5-2.9-3-1.2 1.2-3-1.2-3 3-1.2 1.5-2.9 3.2.4L12 2.5Z" /><path d="M9.2 12.2l2 2 3.6-4.4" /></svg>
          Verified Artist
        </span>
      <% } %>
      <svg class="pf-cover-doodle" viewBox="0 0 120 90" aria-hidden="true"><path d="M15 66c14-20 23 14 38-2s18-31 31-20 17 20 24 6M67 18c0 8-7 12-15 12 8 0 15 5 15 13 0-8 7-13 15-13-8 0-15-4-15-12ZM21 20c0 5-4 8-9 8 5 0 9 3 9 8 0-5 4-8 9-8-5 0-9-3-9-8Z" /></svg>
    </div>

    <div class="pf-identity">
      <div class="pf-avatar-wrap">
        <img class="pf-avatar" src="<%= profileUser.avatar || '/images/default-avatar.svg' %>" data-fallback-src="/images/default-avatar.svg" alt="<%= profileUser.display_name %>" data-i18n-skip />
        <span class="pf-tape" aria-hidden="true"></span>
      </div>

      <div class="pf-identity-copy">
        <h1 class="pf-name" data-i18n-skip><%= profileUser.display_name %></h1>
        <p class="pf-handle"><span data-i18n-skip>@<%= profileUser.username %></span><% if (memberSince) { %><span class="pf-dot" aria-hidden="true">·</span>Sketching since <%= memberSince %><% } %></p>
      </div>

      <div class="pf-hero-actions">
        <% if (canFollow) { %>
          <form method="POST" action="/follow/<%= profileUser.id %>">
            <button type="submit" class="pf-follow <%= isFollowing ? 'is-following' : '' %>" aria-pressed="<%= isFollowing ? 'true' : 'false' %>">
              <svg viewBox="0 0 24 24" aria-hidden="true"><% if (isFollowing) { %><path d="M5 12.5l4.5 4.5L19 7.5" /><% } else { %><path d="M12 5v14M5 12h14" /><% } %></svg>
              <%= isFollowing ? 'Following artist' : 'Follow artist' %>
            </button>
          </form>
        <% } else if (isOwner) { %>
          <a class="pf-follow pf-edit-link" href="/profile/edit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l11-11a2.1 2.1 0 0 0-3-3L5 17l-1 3Z" /><path d="M13.5 7.5l3 3" /></svg>
            Edit profile
          </a>
        <% } %>
        <button class="pf-share" type="button" data-share-artwork data-share-title="<%= profileUser.display_name %> on ArtSpace" data-share-text="Sketchbook of <%= profileUser.display_name %> (@<%= profileUser.username %>) on ArtSpace" data-share-url="<%= profileUrl %>" aria-label="Share this profile">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.4" /><circle cx="17.5" cy="5.5" r="2.4" /><circle cx="17.5" cy="18.5" r="2.4" /><path d="M8.3 10.9l7-4.2M8.3 13.1l7 4.2" /></svg>
          <span data-share-label>Share</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ============ Pinned stat notes ============ -->
  <dl class="pf-stats" aria-label="Artist statistics">
    <div class="pf-note">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.2-4.2L14.5 6.5a2.12 2.12 0 0 1 3 3L8.2 18.8 4 20Z" /><path d="M12.5 8.5l3 3" /></svg>
      <dd><%= numeral(stats.totalArtworks) %></dd>
      <dt>Artworks</dt>
    </div>
    <div class="pf-note">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.2-4.6-9.4-9.4A5.4 5.4 0 0 1 12 6.6a5.4 5.4 0 0 1 9.4 4A13.6 13.6 0 0 1 12 20Z" /></svg>
      <dd><%= numeral(stats.totalLikes) %></dd>
      <dt>Likes received</dt>
    </div>
    <div class="pf-note">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8.5" r="3.2" /><path d="M3.5 19.5c.8-3.4 3-5.2 5.5-5.2s4.7 1.8 5.5 5.2M16 5.5a3.2 3.2 0 0 1 0 6.1M18.5 14.6c1.6 1 2.6 2.7 3 4.9" /></svg>
      <dd><%= numeral(stats.followers) %></dd>
      <dt>Followers</dt>
    </div>
    <div class="pf-note">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6l-.8 4.6 3 3.1v2.1H6.8v-2.1l3-3.1L9 4Z" /><path d="M12 14v6" /></svg>
      <dd><%= numeral(stats.totalPins) %></dd>
      <dt>Pinned works</dt>
    </div>
  </dl>

  <div class="pf-layout">

    <!-- ============ Main column ============ -->
    <div class="pf-main">

      <section class="pf-card pf-about" aria-labelledby="pf-about-heading">
        <div class="pf-card-head">
          <h2 id="pf-about-heading">About the artist</h2>
          <svg viewBox="0 0 60 60" aria-hidden="true"><path d="M8 44 14 30 38 8l8 8L24 40 8 44Z" /><path d="M33 13l8 8" /><path d="M12 36l6 6" /></svg>
        </div>

        <p class="pf-bio"<%- profileUser.bio && profileUser.bio.trim() ? ' data-i18n-skip' : '' %>><%= profileUser.bio && profileUser.bio.trim() ? profileUser.bio : 'This artist is sketching their way into the community — fresh pages, honest lines, everyday wonder.' %></p>

        <% if (profileUser.website || profileUser.instagram || profileUser.twitter) { %>
          <ul class="pf-socials">
            <% if (profileUser.website) { %>
              <li>
                <a class="pf-social" href="<%= profileUser.website %>" target="_blank" rel="noreferrer">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a13 13 0 0 1 0 17M3.5 12h17" /></svg>
                  <span class="pf-social-label">Website</span>
                  <span class="pf-social-value"><%= profileUser.website.replace(/^https?:\/\//, '') %></span>
                </a>
              </li>
            <% } %>
            <% if (profileUser.instagram) { %>
              <li>
                <span class="pf-social pf-social-static">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.6" /><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" /></svg>
                  <span class="pf-social-label">Instagram</span>
                  <span class="pf-social-value"><%= profileUser.instagram %></span>
                </span>
              </li>
            <% } %>
            <% if (profileUser.twitter) { %>
              <li>
                <span class="pf-social pf-social-static">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5l6.6 8.4L4.3 19h2.6l3.9-3.6L12.5 19H20l-6.5-8.3L19.4 5h-2.6l-3.6 3.4L11.6 5H4Z" /></svg>
                  <span class="pf-social-label">Twitter</span>
                  <span class="pf-social-value"><%= profileUser.twitter %></span>
                </span>
              </li>
            <% } %>
          </ul>
        <% } %>

        <div class="pf-notebook">
          <h3>In this notebook</h3>
          <% if (artworks.length) { %>
            <% artworks.slice(0, 3).forEach((artwork, index) => { %>
              <a class="pf-notebook-row" href="/art/<%= artwork.id %>">
                <span class="pf-notebook-index"><%= String(index + 1).padStart(2, '0') %></span>
                <span class="pf-notebook-meta">
                  <span><%= artwork.category_name || 'Artwork' %></span>
                  <strong data-i18n-skip><%= artwork.title %></strong>
                </span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
              </a>
            <% }) %>
          <% } else { %>
            <p class="pf-notebook-empty">New pages are waiting to be drawn.</p>
          <% } %>
        </div>
      </section>

      <section class="pf-portfolio pf-collection" aria-labelledby="pf-portfolio-heading" data-portfolio>
        <svg class="pf-collection-doodle" viewBox="0 0 160 160" aria-hidden="true">
          <path d="M31 111c18-25 38-51 64-77M89 51c8-7 16-10 23-9 8 2 9 12 2 21-9 13-23 18-35 22" />
          <path d="M23 128c17-2 33 0 49 5M112 112c9-5 19-7 29-5" />
          <path d="M26 32c0 8-6 14-14 14 8 0 14 6 14 14 0-8 6-14 14-14-8 0-14-6-14-14Z" />
        </svg>

        <div class="pf-collection-head">
          <div class="pf-collection-heading">
            <span class="pf-collection-kicker"><%= collectionKicker %> <i>/</i> <span><%= collectionCountLabel %></span></span>
            <div class="pf-collection-title-wrap">
              <h2 id="pf-portfolio-heading"><%= collectionTitle %></h2>
              <svg class="pf-collection-underline" viewBox="0 0 260 18" preserveAspectRatio="none" aria-hidden="true">
                <path d="M4 12c44-7 94-8 142-5 37 2 73 5 110 2" />
                <path d="M28 15c60-4 120-4 180-1" />
              </svg>
            </div>
            <p class="pf-collection-blurb"><%= collectionBlurb %></p>
          </div>

          <div class="pf-collection-count" aria-label="<%= portfolioCount %> works in this collection">
            <span class="pf-collection-pin" aria-hidden="true"></span>
            <strong><%= numeral(portfolioCount) %></strong>
            <span><%= portfolioCount === 1 ? 'piece' : 'pieces' %><br /><%= activeTab === 'artworks' ? 'in the collection' : 'in this set' %></span>
          </div>
        </div>

        <div class="pf-collection-nav">
          <div class="pf-collection-bar">
            <nav class="pf-tabs" aria-label="Portfolio collections">
              <a class="pf-tab <%= activeTab === 'artworks' ? 'is-active' : '' %>" href="/profile/<%= profileUser.username %>?tab=artworks" aria-current="<%= activeTab === 'artworks' ? 'page' : 'false' %>">Artworks <sup><%= numeral(stats.totalArtworks) %></sup></a>
              <a class="pf-tab <%= activeTab === 'liked' ? 'is-active' : '' %>" href="/profile/<%= profileUser.username %>?tab=liked" aria-current="<%= activeTab === 'liked' ? 'page' : 'false' %>">Liked <sup><%= numeral(likedArtworks.length) %></sup></a>
              <% if (isOwner) { %>
                <a class="pf-tab <%= activeTab === 'pinned' ? 'is-active' : '' %>" href="/profile/<%= profileUser.username %>?tab=pinned" aria-current="<%= activeTab === 'pinned' ? 'page' : 'false' %>">Pinned <sup><%= numeral(pinnedItems.length) %>/<%= pinLimit %></sup></a>
                <a class="pf-tab <%= activeTab === 'saved' ? 'is-active' : '' %>" href="/profile/<%= profileUser.username %>?tab=saved" aria-current="<%= activeTab === 'saved' ? 'page' : 'false' %>">Saved <sup><%= numeral(savedArtworks.length) %></sup></a>
              <% } %>
            </nav>

            <% if (portfolioItems.length) { %>
              <div class="pf-collection-tools">
                <div class="pf-collection-sort" role="group" aria-label="Sort artworks">
                  <button type="button" class="pf-sort-button is-active" data-portfolio-sort="all" aria-pressed="true">All artwork</button>
                  <button type="button" class="pf-sort-button" data-portfolio-sort="recent" aria-pressed="false">Recent</button>
                  <button type="button" class="pf-sort-button" data-portfolio-sort="popular" aria-pressed="false">Most liked</button>
                </div>

                <label class="pf-collection-search">
                  <span class="pf-collection-sr-only">Search this collection</span>
                  <svg class="pf-collection-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
                  <input type="search" placeholder="Search this collection..." autocomplete="off" data-portfolio-search />
                  <button type="button" class="pf-collection-search-clear" data-portfolio-search-clear aria-label="Clear search" hidden>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                  </button>
                </label>
              </div>
            <% } %>
          </div>

          <% if (portfolioItems.length && portfolioCategories.length > 1) { %>
            <div class="pf-collection-filters" role="group" aria-label="Filter artwork by medium" data-portfolio-filters>
              <span class="pf-collection-filter-label">Mediums</span>
              <button type="button" class="pf-collection-filter is-active" data-portfolio-category="all" aria-pressed="true">All <sup><%= portfolioItems.length %></sup></button>
              <% portfolioCategories.forEach((category) => { %>
                <button type="button" class="pf-collection-filter" data-portfolio-category="<%= category.name %>" aria-pressed="false"><%= category.name %> <sup><%= category.count %></sup></button>
              <% }) %>
            </div>
          <% } %>
        </div>

        <% if (portfolioItems.length) { %>
          <div class="pf-collection-status-row">
            <p class="pf-collection-status" aria-live="polite" data-portfolio-status>Showing <strong><%= portfolioItems.length %></strong> of <strong><%= portfolioItems.length %></strong> pieces</p>
            <button type="button" class="pf-collection-reset" data-portfolio-reset hidden>Clear filters</button>
          </div>

          <div class="pf-art-grid" data-portfolio-gallery<%= activeTab === 'pinned' ? ' data-profile-pinned' : '' %>>
            <% portfolioItems.forEach((artwork, index) => { %>
              <%- include('../partials/portfolio-art-card', { artwork, showArtist: activeTab !== 'artworks', eager: index < 4 }) %>
            <% }) %>
          </div>

          <div class="pf-collection-empty pf-collection-empty--results" data-portfolio-no-results hidden role="status">
            <svg class="pf-collection-empty-art pf-collection-empty-art--small" viewBox="0 0 160 110" aria-hidden="true">
              <circle cx="67" cy="48" r="25" />
              <path d="m85 67 24 24M55 46c7-8 15-8 22 0M75 84c-17 3-32 3-48 0" />
            </svg>
            <p class="pf-collection-kicker">Nothing on this page</p>
            <h3>No artwork matches those filters.</h3>
            <p>Try another medium, or clear the search to see the whole collection.</p>
            <button type="button" class="pf-collection-cta" data-portfolio-reset>Clear filters</button>
          </div>
        <% } else { %>
          <div class="pf-collection-empty pf-collection-empty--blank">
            <svg class="pf-collection-empty-art" viewBox="0 0 220 160" aria-hidden="true">
              <path d="M27 136c54-12 112-12 166 0" />
              <path d="M46 30c40-4 88-4 128 0l-4 92c-40 4-82 4-122 0L46 30Z" />
              <path d="M46 30l-5 92M51 45l118-1M51 122l115 1" />
              <path d="M72 64c28-5 52-5 76 0M72 82c24-3 46-3 68 0M72 100c15-2 31-2 45 0" />
              <path d="M173 106l21-26 9 7-20 28-10 5 0-14Z" />
              <path d="M70 139c0 6-5 10-11 10 6 0 11 4 11 10 0-6 5-10 11-10-6 0-11-4-11-10Z" />
            </svg>
            <p class="pf-collection-kicker"><%= emptyKicker %></p>
            <h3><%= emptyTitle %></h3>
            <p><%= emptyMessage %></p>
            <div class="pf-collection-empty-actions">
              <% if (activeTab === 'artworks' && isOwner) { %>
                <a class="pf-collection-cta pf-collection-cta--solid" href="/upload">
                  Upload artwork
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                </a>
              <% } else { %>
                <a class="pf-collection-cta" href="/explore">
                  Explore the gallery
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                </a>
              <% } %>
            </div>
          </div>
        <% } %>
      </section>
    </div>

    <!-- ============ Sidebar ============ -->
    <aside class="pf-side">

      <section class="pf-card pf-specimen" aria-label="Artist card">
        <span class="pf-specimen-label" aria-hidden="true">The Artist's Table</span>
        <div class="pf-specimen-top">
          <img class="pf-specimen-avatar" src="<%= profileUser.avatar || '/images/default-avatar.svg' %>" data-fallback-src="/images/default-avatar.svg" alt="<%= profileUser.display_name %>" loading="lazy" data-i18n-skip />
          <div class="pf-specimen-copy">
            <h3 data-i18n-skip><%= profileUser.display_name %></h3>
            <p data-i18n-skip>@<%= profileUser.username %></p>
            <span class="pf-role"><%= profileUser.role === 'admin' ? 'Studio keeper' : (profileUser.is_verified ? 'Verified artist' : 'Artist on ArtSpace') %></span>
          </div>
        </div>
        <dl class="pf-ledger">
          <div><dt>Behind this work</dt><dd><%= numeral(artworks.length) %> public pages</dd></div>
          <div><dt>Appreciation</dt><dd><%= numeral(stats.totalLikes) %> likes</dd></div>
          <div><dt>People following</dt><dd><%= numeral(stats.followers) %></dd></div>
          <div><dt>Pinned to homepage</dt><dd><%= numeral(stats.totalPins) %></dd></div>
        </dl>
      </section>

      <% if (latest) { %>
        <section class="pf-card pf-pinned" aria-label="Latest artwork">
          <span class="pf-side-label" aria-hidden="true">Pinned latest</span>
          <a class="pf-pinned-link" href="/art/<%= latest.id %>">
            <%
              const latestSrc = imageTools.cardSrc(latest, 480);
              const latestSrcset = imageTools.cardSrcset(latest, [320, 480, 640]);
            %>
            <img src="<%= latestSrc %>"<% if (latestSrcset) { %> srcset="<%= latestSrcset %>" sizes="(max-width: 640px) 88vw, 300px"<% } %> data-fallback-src="/images/default-artwork.svg" alt="<%= latest.title %>" loading="lazy" decoding="async" data-i18n-skip />
            <span class="pf-pinned-meta">
              <span><%= latest.category_name || 'Artwork' %></span>
              <strong data-i18n-skip><%= latest.title %></strong>
            </span>
          </a>
        </section>
      <% } %>

      <section class="pf-card pf-clippings" aria-label="Saved and liked clippings">
        <span class="pf-side-label" aria-hidden="true">Clipped from the gallery</span>
        <div class="pf-clipping-grid <%= isOwner ? '' : 'pf-clipping-grid--single' %>">
          <a class="pf-clipping-item" href="/profile/<%= profileUser.username %>?tab=liked">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.2-4.6-9.4-9.4A5.4 5.4 0 0 1 12 6.6a5.4 5.4 0 0 1 9.4 4A13.6 13.6 0 0 1 12 20Z" /></svg>
            <strong><%= likedArtworks.length %></strong>
            <span>Liked works</span>
          </a>
          <% if (isOwner) { %>
            <a class="pf-clipping-item" href="/profile/<%= profileUser.username %>?tab=saved">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v16l-5-4-5 4V4Z" /></svg>
              <strong><%= savedArtworks.length %></strong>
              <span>Saved works</span>
            </a>
          <% } %>
        </div>
      </section>

    </aside>
  </div>
</div>

<%- include('../partials/footer') %>
