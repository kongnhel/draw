<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1>Forgot password</h1>
    <div class="page-subtitle">Password reset flows are not active in this demo build.</div>
  </div>
</div>

<div class="form-card" style="max-width: 620px; margin: 0 auto;">
  <% if (typeof message !== 'undefined' && message) { %>
    <div class="empty-state" style="margin-bottom: 16px; color: #dfefff; border-color: rgba(122,92,255,0.25);"><%= message %></div>
  <% } %>

  <form action="/forgot-password" method="POST">
    <div class="form-block">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" placeholder="you@example.com" required />
    </div>

    <div class="submit-row">
      <button type="submit" class="btn btn-primary">Request reset</button>
      <a href="/login" class="btn btn-ghost">Back to login</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
