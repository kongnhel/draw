<article class="studio-explore-card" data-explore-card data-artwork-view data-artwork-id="<%= artwork.id %>" data-artwork-full="<%= artwork.image_url || artwork.thumbnail_url %>" data-artwork-thumb="<%= artwork.thumbnail_url || artwork.image_url %>" data-artwork-title="<%= artwork.title %>" data-artwork-description="<%= artwork.description || '' %>" data-artwork-category="<%= artwork.category_name || '' %>" data-artwork-tags="<%= artwork.tags || '' %>" data-artwork-effect="<%= artwork.visual_effect || 'auto' %>" data-artwork-artist="<%= artwork.display_name || artwork.username %>" data-artwork-artist-url="/profile/<%= artwork.username %>" data-artwork-date="<%= artwork.created_at_label || 'Original artwork' %>" data-artwork-liked="<%= artwork.is_liked ? 'true' : 'false' %>" data-artwork-saved="<%= artwork.is_bookmarked ? 'true' : 'false' %>" data-artwork-likes="<%= artwork.likes_count || 0 %>">
  <%
    const cardSrc = imageTools.cardSrc(artwork, 480);
    const cardSrcset = imageTools.cardSrcset(artwork, [320, 480, 640, 800]);
    const cardOwned = typeof currentUser !== 'undefined' && currentUser && artwork.username === currentUser.username;
    const cardPinned = typeof pinnedIds !== 'undefined' && pinnedIds && pinnedIds.has(Number(artwork.id));
  %>
  <span class="studio-explore-card-tape" aria-hidden="true"></span>

  <a class="studio-explore-card-image" href="/art/<%= artwork.id %>" aria-label="View <%= artwork.title %> by <%= artwork.display_name || artwork.username %>">
    <img src="<%= cardSrc %>"<% if (cardSrcset) { %> srcset="<%= cardSrcset %>" sizes="(max-width: 640px) 88vw, (max-width: 1080px) 44vw, 320px"<% } %> data-fallback-src="<%= artwork.image_url || '/images/default-artwork.svg' %>" alt="<%= artwork.title %>" loading="lazy" decoding="async" />
    <span class="studio-explore-card-placeholder" aria-hidden="true">
      <svg viewBox="0 0 80 80"><path d="M15 62 26 24l29-12 8 29-23 23-25-2Z" /><path d="m26 24 29 17M35 64l-9-40" /></svg>
      <strong><%= artwork.title %></strong>
      <small>Artwork image unavailable</small>
    </span>
    <span class="studio-explore-card-open" aria-hidden="true">
      Open artwork
      <svg viewBox="0 0 24 24"><path d="M5 19 19 5M9 5h10v10" /></svg>
    </span>
  </a>

  <% if (cardOwned) { %>
    <button type="button" class="studio-explore-pin<%= cardPinned ? ' is-pinned' : '' %>" data-pin-toggle data-artwork-id="<%= artwork.id %>" data-pinned="<%= cardPinned ? 'true' : 'false' %>" aria-pressed="<%= cardPinned ? 'true' : 'false' %>" title="<%= cardPinned ? 'Unpin from homepage' : 'Pin to homepage' %>">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6l-.8 4.6 3 3.1v2.1H6.8v-2.1l3-3.1L9 4Z" /><path d="M12 14v6" /></svg>
      <span data-pin-label><%= cardPinned ? 'Pinned' : 'Pin' %></span>
    </button>
  <% } else if (cardPinned) { %>
    <span class="studio-explore-pin-badge" title="Pinned to homepage">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6l-.8 4.6 3 3.1v2.1H6.8v-2.1l3-3.1L9 4Z" /><path d="M12 14v6" /></svg>
    </span>
  <% } %>

  <form class="studio-explore-save" method="POST" action="/art/<%= artwork.id %>/bookmark">
    <button type="submit" class="<%= artwork.is_bookmarked ? 'active' : '' %>" aria-pressed="<%= artwork.is_bookmarked ? 'true' : 'false' %>" aria-label="<%= artwork.is_bookmarked ? 'Remove from saved artworks' : 'Save artwork' %>"><%= artwork.is_bookmarked ? 'Saved' : 'Save' %></button>
  </form>

  <div class="studio-explore-card-copy">
    <div class="studio-explore-card-meta">
      <span><%= artwork.category_name || 'Original artwork' %></span>
      <time datetime="<%= artwork.created_at %>"><%= artwork.created_at_label || 'Fresh' %></time>
    </div>
    <h3><a href="/art/<%= artwork.id %>"><%= artwork.title %></a></h3>
    <a class="studio-explore-card-artist" href="/profile/<%= artwork.username %>">
      <img src="<%= artwork.avatar || '/uploads/avatars/default-avatar.svg' %>" data-explore-avatar="/uploads/avatars/default-avatar.svg" alt="" loading="lazy" />
      <span>by <%= artwork.display_name || artwork.username %></span>
    </a>
    <div class="studio-explore-card-metrics">
      <span class="studio-explore-card-likes">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 5.8a5.4 5.4 0 0 0-7.7 0L12 7l-1.1-1.2a5.4 5.4 0 1 0-7.7 7.7L12 22l8.8-8.5a5.4 5.4 0 0 0 0-7.7Z" /></svg>
        <span data-explore-likes-for="<%= artwork.id %>"><%= artwork.likes_count || 0 %></span>
      </span>
      <span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-3-.4-4.2-1.1L3 21l1.7-4.7A8.4 8.4 0 0 1 3.5 12 8.5 8.5 0 0 1 12 3.5 8.5 8.5 0 0 1 21 12Z" /></svg>
        <%= artwork.comments_count || 0 %>
      </span>
    </div>

    <% if (cardOwned) { %>
      <div class="studio-explore-owner-actions">
        <a class="studio-explore-owner-action" href="/art/<%= artwork.id %>/edit" data-no-viewer aria-label="Edit <%= artwork.title %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l11-11a2.1 2.1 0 0 0-3-3L5 17l-1 3Z" /><path d="M13.5 7.5l3 3" /></svg>
          <span>Edit</span>
        </a>
        <form method="POST" action="/art/<%= artwork.id %>/delete" onsubmit="return confirm('Delete this artwork? This cannot be undone.');">
          <button type="submit" class="studio-explore-owner-action is-danger" aria-label="Delete <%= artwork.title %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M6.5 7l1 13h9l1-13" /></svg>
            <span>Delete</span>
          </button>
        </form>
      </div>
    <% } %>
  </div>
</article>
