      </main>
      </div>

      <dialog class="art-viewer" data-art-viewer aria-labelledby="art-viewer-title" tabindex="-1">
        <div class="art-viewer-shell">
          <div class="art-viewer-particles" data-viewer-particles aria-hidden="true"></div>
          <div class="art-viewer-toolbar">
            <span class="art-viewer-brand">ARTSPACE <span>ARTWORK VIEWER</span></span>
            <div class="art-viewer-tools">
              <button class="art-viewer-tool" type="button" data-viewer-sound aria-label="Enable sound" aria-pressed="false" title="Enable subtle sound">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4H4Z" /><path class="sound-wave" d="M16 9a5 5 0 0 1 0 6m3-9a9 9 0 0 1 0 12" /></svg>
              </button>
              <button class="art-viewer-tool" type="button" data-viewer-effects aria-label="Disable visual effects" aria-pressed="true" title="Disable visual effects">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6L12 3Zm7 12 .9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15Z" /></svg>
              </button>
              <button class="art-viewer-tool" type="button" data-viewer-zoom aria-label="Zoom in" title="Zoom in">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5M10.8 7.5v6.6M7.5 10.8h6.6" /></svg>
              </button>
              <button class="art-viewer-tool" type="button" data-viewer-fullscreen aria-label="Enter fullscreen" title="Enter fullscreen">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4H4v4m12-4h4v4M4 16v4h4m12-4v4h-4" /></svg>
              </button>
              <button class="art-viewer-tool art-viewer-close" type="button" data-viewer-close aria-label="Close artwork viewer" title="Close">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
              </button>
            </div>
          </div>
          <button class="art-viewer-step art-viewer-previous" type="button" data-viewer-prev aria-label="Previous artwork" title="Previous artwork">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <figure class="art-viewer-stage">
            <img class="art-viewer-image" data-viewer-image alt="" data-i18n-skip />
            <svg class="art-viewer-drawn-frame" data-viewer-frame viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 3 C18 2 31 4 49 3 C66 2 82 4 98 3 L97 97 C79 96 65 98 49 97 C31 96 17 98 3 97 Z" /></svg>
            <div class="art-viewer-loader" data-viewer-loader aria-hidden="true"></div>
            <div class="art-viewer-image-placeholder" data-viewer-placeholder aria-hidden="true">This artwork image is unavailable.</div>
          </figure>
          <button class="art-viewer-step art-viewer-next" type="button" data-viewer-next aria-label="Next artwork" title="Next artwork">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>
          <div class="art-viewer-caption">
            <span class="art-viewer-count" data-viewer-count aria-live="polite"></span>
            <div class="art-viewer-description">
              <a class="art-viewer-artist" data-viewer-artist href="#" data-i18n-skip></a>
              <h2 id="art-viewer-title" data-viewer-title data-i18n-skip>Artwork</h2>
              <p data-viewer-date></p>
              <p class="art-viewer-description-text" data-viewer-description data-i18n-skip></p>
            </div>
            <div class="art-viewer-caption-actions">
              <div class="art-viewer-social-actions">
                <form method="POST" action="/art/1/like" data-viewer-like-form>
                  <button class="art-viewer-action" type="submit" data-viewer-like aria-pressed="false">
                    <svg class="art-viewer-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" /></svg>
                    <span class="art-viewer-action-label" data-viewer-like-label>Like</span>
                    <span class="art-viewer-like-count" data-viewer-like-count aria-live="polite"></span>
                  </button>
                </form>
                <form method="POST" action="/art/1/bookmark" data-viewer-bookmark-form>
                  <button class="art-viewer-action" type="submit" data-viewer-bookmark aria-pressed="false">
                    <svg class="art-viewer-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5A1.5 1.5 0 0 1 7.5 3h9A1.5 1.5 0 0 1 18 4.5V21l-6-4-6 4V4.5Z" /></svg>
                    <span class="art-viewer-action-label" data-viewer-bookmark-label>Save</span>
                  </button>
                </form>
                <button class="art-viewer-action" type="button" data-viewer-share>
                  <svg class="art-viewer-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v5h14v-5" /></svg>
                  <span class="art-viewer-action-label" data-viewer-share-label>Share</span>
                </button>
                <button class="art-viewer-action" type="button" data-viewer-related-toggle aria-expanded="false">
                  <svg class="art-viewer-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z" /></svg>
                  <span class="art-viewer-action-label">Related</span>
                </button>
              </div>
              <div class="art-viewer-owner-actions" data-viewer-owner-actions hidden>
                <a class="art-viewer-action art-viewer-action--owner" data-viewer-edit href="#" data-no-viewer>
                  <svg class="art-viewer-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Z" /><path d="m13.5 7.5 3 3" /></svg>
                  <span class="art-viewer-action-label">Edit</span>
                </a>
                <a class="art-viewer-action art-viewer-action--owner" data-viewer-download href="#" download target="_blank" rel="noopener">
                  <svg class="art-viewer-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14" /></svg>
                  <span class="art-viewer-action-label">Download</span>
                </a>
                <form method="POST" action="/art/1/delete" data-viewer-delete-form onsubmit="return confirm('Delete this artwork? This cannot be undone.');">
                  <button class="art-viewer-action art-viewer-action--danger" type="submit" data-viewer-delete>
                    <svg class="art-viewer-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13" /></svg>
                    <span class="art-viewer-action-label">Delete</span>
                  </button>
                </form>
              </div>
              <a class="art-viewer-details" data-viewer-detail href="#">
                <span>Open artwork details</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
              </a>
            </div>
            <section class="art-viewer-related" data-viewer-related hidden aria-label="Related artworks">
              <div class="art-viewer-related-heading">
                <span>Related works</span>
                <button class="art-viewer-related-close" type="button" data-viewer-related-close aria-label="Close related artworks">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
              </div>
              <div class="art-viewer-related-list" data-viewer-related-list></div>
            </section>
          </div>
        </div>
      </dialog>

      <footer class="site-footer">
        <div class="container footer-grid">
          <div>
            <div class="brand footer-brand">
              <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 40 40" focusable="false"><path d="m11 29 3-9L26 8l6 6-12 12-9 3Z" /><path d="m14 20 6 6M25 9l6 6M10 31l9-3M8 34l2-3" /><path d="M8 9c2-2 4-2 6 0" /></svg>
              </span>
              <span>ArtSpace</span>
            </div>
            <p>Showcase your creative work. Discover talent. Build an art community.</p>
          </div>

          <div>
            <h4>Explore</h4>
            <ul>
              <li><a href="/explore">Artwork</a></li>
              <li><a href="/explore?category=digital-art">Digital Art</a></li>
              <li><a href="/explore?category=portrait-drawing">Portraits</a></li>
            </ul>
          </div>

          <div>
            <h4>Community</h4>
            <ul>
              <li><a href="/dashboard">Dashboard</a></li>
              <li><a href="/upload">Upload</a></li>
              <li><a href="/notifications">Notifications</a></li>
            </ul>
          </div>

          <div>
            <h4>About</h4>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/register">Join</a></li>
              <li><a href="/privacy">Privacy &amp; ads</a></li>
              <li><a href="/forgot-password">Help</a></li>
            </ul>
          </div>
        </div>

        <div class="container footer-bottom">
          <span>© 2026 ArtSpace / kong dark</span>
          <button class="intro-replay" type="button" data-intro-replay aria-label="Replay the ArtSpace pencil intro">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v5h5" /><path d="m10 14 2-5 1.2 3 3 1-3 1.2L12 18l-1-4-1 .5" /></svg>
            <span>Replay intro</span>
          </button>
          <button class="sound-toggle" type="button" data-sound-toggle aria-pressed="false" aria-label="Sound effects off, activate to turn on" title="Toggle sound effects">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 10v4h4l5 4V6l-5 4H4Z" stroke-linejoin="round"/>
              <path class="sound-toggle-waves" d="M16 9a5 5 0 0 1 0 6m3-9a9 9 0 0 1 0 12"/>
              <path class="sound-toggle-mute" d="m16.5 9.5 5 5m0-5-5 5"/>
            </svg>
            <span data-sound-label>Sound Off</span>
          </button>
          <span>Crafted for artists and art lovers.</span>
        </div>
      </footer>

      <%- include('./mobile-bottom-nav') %>
      <%- include('./consent-banner') %>
    </div>

    <script src="/js/app.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/spa-nav.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/navbar.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/cursor.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/interactions.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/background-falling.js?v=<%= assetVersion %>" defer></script>
    <% if (typeof locale !== 'undefined' && locale === 'km' && typeof i18nClient !== 'undefined' && i18nClient) { %>
    <div data-i18n-km hidden><%- JSON.stringify(i18nClient).replace(/</g, '\\u003c') %></div>
    <% } %>
    <script src="/js/i18n.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/ads.js?v=<%= assetVersion %>" defer></script>

  </body>
</html>
