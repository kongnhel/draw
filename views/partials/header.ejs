<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'km' %>" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="asset-version" content="<%= assetVersion %>" />
    <meta name="current-username" content="<%= typeof currentUser !== 'undefined' && currentUser ? currentUser.username : '' %>" />
    <title><%= pageTitle || 'ArtSpace' %></title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232a312b'/%3E%3Cpath d='M9 23l2-6 9-9 4 4-9 9-6 2Z' fill='none' stroke='%23f7f1e6' stroke-width='1.8' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <meta name="description" content="ArtSpace is a premium art and drawing social platform for artists and art lovers." />
    <meta name="theme-color" content="#171717" />
    <meta name="google-adsense-account" content="ca-pub-9143750053355750" />
    <meta name="adsense-client" content="<%= typeof adsenseClient !== 'undefined' ? adsenseClient : 'ca-pub-9143750053355750' %>" />
    <meta name="adsense-script" content="<%= typeof adsenseScriptUrl !== 'undefined' ? adsenseScriptUrl : 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9143750053355750' %>" />
    <meta name="ads-consent" content="<%= typeof adsConsent !== 'undefined' && adsConsent ? adsConsent : 'unset' %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <% if (typeof imagekitOrigin !== 'undefined' && imagekitOrigin) { %>
      <link rel="preconnect" href="<%= imagekitOrigin %>" crossorigin />
    <% } %>
    <% if (typeof heroArtwork !== 'undefined' && heroArtwork && heroArtwork.image_url && typeof imageTools !== 'undefined') { %>
      <%
        const heroPreloadSrc = imageTools.transformUrl(heroArtwork.image_url, 720);
        const heroPreloadSrcset = imageTools.srcset(heroArtwork.image_url, [320, 480, 720, 960, 1200]);
      %>
      <link rel="preload" as="image" href="<%= heroPreloadSrc %>"<% if (heroPreloadSrcset) { %> imagesrcset="<%= heroPreloadSrcset %>" imagesizes="(max-width: 480px) 40vw, (max-width: 1080px) 46vw, 480px"<% } %> fetchpriority="high" />
    <% } %>
    <%
      const fontCssUrl = 'https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=Kantumruy+Pro:wght@400;500;600;700&family=Noto+Sans+Khmer:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap';
    %>
    <link rel="preload" as="style" href="<%= fontCssUrl %>" />
    <link rel="stylesheet" href="<%= fontCssUrl %>" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="<%= fontCssUrl %>" /></noscript>
    <link rel="stylesheet" href="/css/bundle.css?v=<%= assetVersion %>" />
    <% if (typeof adsAllowed !== 'undefined' && adsAllowed && adsConsent === 'granted') { %>
      <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
      <script async id="artspace-adsense-script" src="<%= typeof adsenseScriptUrl !== 'undefined' ? adsenseScriptUrl : 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9143750053355750' %>" crossorigin="anonymous"></script>
    <% } %>
    <script>
      (function () {
        try {
          var root = document.documentElement;
          var theme = localStorage.getItem('artspace-sketchbook-theme');
          var activeTheme = theme === 'light' ? 'light' : 'dark';
          root.setAttribute('data-theme', activeTheme);
          var themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) themeColor.setAttribute('content', activeTheme === 'light' ? '#f8f5ed' : '#171717');

          var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
          var memory = Number(navigator.deviceMemory) || 8;
          var cores = Number(navigator.hardwareConcurrency) || 8;
          var forced = localStorage.getItem('artspace-perf');
          var lowPower = memory <= 2
            || (memory <= 4 && cores <= 4)
            || (connection && (connection.saveData || /(^|-)2g$/.test(connection.effectiveType || '')));
          if (forced === 'low' || (forced !== 'high' && lowPower)) root.setAttribute('data-perf', 'low');
          else root.removeAttribute('data-perf');

          var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var seen = localStorage.getItem('artspace-intro-seen-v1') === '1';
          if (!seen && !reduced) {
            root.classList.add('intro-pending');
            window.__introFallback = window.setTimeout(function () {
              if (!window.__introReady) root.classList.remove('intro-pending');
            }, 10000);
          }
        } catch (error) {}
      })();
    </script>
    <script src="/js/intro.js?v=<%= assetVersion %>" defer></script>
  </head>
  <%
    const bgSceneSource = (typeof artwork !== 'undefined' && artwork && (artwork.category_name || artwork.category))
      || (typeof filter !== 'undefined' && filter)
      || (typeof activeCategory !== 'undefined' && activeCategory && (activeCategory.slug || activeCategory))
      || '';
    const bgSceneValue = String(bgSceneSource || '').trim().toLowerCase();
    const bodyTitle = typeof pageTitle === 'string' ? pageTitle : '';
  %>
  <body data-theme="dark" data-locale="<%= typeof locale !== 'undefined' ? locale : 'km' %>" class="<%= bodyTitle === 'ArtSpace | Discover original artwork' ? 'home-body' : '' %> <%= bodyTitle.includes('Login') || bodyTitle.includes('Register') ? 'auth-body' : '' %> <%= bodyTitle.includes('Dashboard') ? 'dashboard-body' : '' %> <%= bodyTitle.includes('Admin') ? 'admin-body' : '' %> <%= bodyTitle.includes('Upload') ? 'upload-body' : '' %> <%= bodyTitle.includes('Explore') ? 'explore-body' : '' %> <%= bodyTitle.includes('Community') ? 'community-body' : '' %> <%= bodyTitle.includes('Edit artwork') ? 'edit-body' : '' %>">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <%- include('./intro') %>
    <div class="bg-falling" aria-hidden="true">
      <canvas class="bg-falling-canvas" data-bg-falling data-scene="<%= bgSceneValue %>"></canvas>
    </div>
    <div class="page-shell">
      <div class="route-loader" data-route-loader aria-hidden="true" hidden>
        <span class="route-loader-track"><span class="route-loader-fill"></span><span class="route-loader-pencil"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 20l2.5-7L16 3.5l4.5 4.5L11 17.5 4 20Z" /><path d="M14 6l4 4M6.5 17.5l2 2" /></svg></span></span>
      </div>
      <p class="route-announcer" data-route-announcer role="status" aria-live="polite"></p>
      <header class="topbar" data-topbar>
        <div class="container nav-wrap">
          <a href="/" class="brand" aria-label="ArtSpace home">
            <span class="brand-mark" aria-hidden="true">
              <svg viewBox="0 0 40 40" focusable="false">
                <path class="brand-pencil" d="m11 29 3-9L26 8l6 6-12 12-9 3Z" />
                <path class="brand-pencil-detail" d="m14 20 6 6M25 9l6 6M10 31l9-3M8 34l2-3" />
                <path class="brand-pencil-doodle" d="M7.5 8.5c2.2-2 4.4-2 6.5.2" />
                <path class="brand-underline" d="M8 36.5c7.5-1.8 15.5-2 24.5-1.2" />
              </svg>
            </span>
            <span class="brand-word">ArtSpace</span>
          </a>

          <nav class="nav-links" id="primary-nav" aria-label="Main navigation">
            <div class="nav-drawer-head">
              <div class="nav-drawer-title">
                <span class="nav-drawer-kicker">Sketchbook</span>
                <strong>Navigation</strong>
              </div>
              <button type="button" class="nav-drawer-close" data-nav-close aria-label="Close menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
              </button>
            </div>

            <div class="nav-link-group">
              <a href="/">Home</a>
              <a href="/explore">Explore</a>
              <a href="/upload">Upload</a>
              <% if (isAuthenticated) { %>
                <% if (currentUser && currentUser.role === 'admin') { %>
                  <a href="/admin">Admin</a>
                <% } else { %>
                  <a href="/dashboard">Dashboard</a>
                <% } %>
              <% } %>
              <span class="nav-ink" data-nav-ink aria-hidden="true"></span>
            </div>

            <% if (typeof categories !== 'undefined' && categories.length) { %>
              <div class="nav-drawer-block nav-drawer-categories-block">
                <span class="nav-drawer-label">Categories</span>
                <div class="nav-drawer-categories">
                  <a href="/explore?category=all">All artwork</a>
                  <% categories.slice(0, 8).forEach((category) => { %>
                    <a href="/explore?category=<%= category.slug %>"><%= category.name %></a>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <div class="nav-drawer-block nav-drawer-language">
              <span class="nav-drawer-label"><%= typeof t === 'function' ? t('Language') : 'Language' %></span>
              <%- include('./language-switch', { className: 'lang-switch--drawer' }) %>
            </div>

            <div class="nav-drawer-block nav-drawer-account">
              <% if (isAuthenticated) { %>
                <a class="nav-drawer-profile" href="/profile/<%= currentUser.username %>">
                  <img src="<%= currentUser.avatar || '/images/default-avatar.svg' %>" alt="" data-fallback-src="/images/default-avatar.svg" />
                  <span>
                    <strong data-i18n-skip><%= currentUser.display_name %></strong>
                    <small data-i18n-skip>@<%= currentUser.username %></small>
                  </span>
                </a>
                <div class="nav-drawer-actions">
                  <a href="/notifications">Notifications</a>
                  <a href="/profile/edit">Settings</a>
                  <a href="/logout">Log out</a>
                </div>
              <% } else { %>
                <div class="nav-drawer-actions">
                  <a href="/login" class="btn btn-ghost">Login</a>
                  <a href="/register" class="btn btn-primary">Join ArtSpace</a>
                </div>
              <% } %>
            </div>
          </nav>

          <form action="/search" method="GET" class="nav-search" role="search" data-nav-search>
            <svg class="nav-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4" /><path d="m15.6 15.6 4.4 4.4" /></svg>
            <label class="sr-only" for="nav-search-input">Search artwork, artists, tags</label>
            <input id="nav-search-input" type="search" name="q" placeholder="Search artwork..." value="<%= typeof query !== 'undefined' ? query : '' %>" autocomplete="off" enterkeyhint="search" />
            <button type="button" class="nav-search-clear" data-search-clear aria-label="Clear search" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg>
            </button>
            <button type="submit" class="nav-search-submit" aria-label="Search">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4" /><path d="m15.6 15.6 4.4 4.4" /></svg>
            </button>
          </form>

          <div class="nav-actions">
            <button class="nav-menu-toggle" type="button" data-nav-toggle aria-controls="primary-nav" aria-expanded="false" aria-label="Open menu">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path class="nav-toggle-line nav-toggle-line-top" d="M5 7h14" /><path class="nav-toggle-line nav-toggle-line-middle" d="M5 12h14" /><path class="nav-toggle-line nav-toggle-line-bottom" d="M5 17h14" /></svg>
            </button>
            <button class="nav-icon-btn nav-search-toggle" type="button" data-search-toggle aria-expanded="false" aria-controls="nav-search-input" aria-label="Open search">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4" /><path d="m15.6 15.6 4.4 4.4" /></svg>
            </button>

            <%- include('./language-switch', { className: 'lang-switch--top' }) %>

            <button class="theme-toggle nav-icon-btn" type="button" aria-label="Toggle theme">
              <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 14.5A8.6 8.6 0 0 1 9.5 3.8 8.6 8.6 0 1 0 20.2 14.5Z" /></svg>
              <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.1 5.1l1.6 1.6M17.3 17.3l1.6 1.6M18.9 5.1l-1.6 1.6M6.7 17.3l-1.6 1.6" /></svg>
            </button>

            <% if (isAuthenticated) { %>
              <div class="nav-notify-wrap" data-notifications-wrap>
                <button type="button" class="nav-icon-btn nav-notify" data-notifications-toggle aria-haspopup="true" aria-expanded="false" aria-controls="notifications-panel" aria-label="Notifications<%= typeof unreadNotifications !== 'undefined' && unreadNotifications > 0 ? ` (${unreadNotifications} unread)` : '' %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 10.2a5.5 5.5 0 0 1 11 0c0 4 1.4 5.4 2 6.1.3.4 0 .9-.5.9H5c-.5 0-.8-.5-.5-.9.6-.7 2-2.1 2-6.1Z" /><path d="M10.2 20a2 2 0 0 0 3.6 0" /></svg>
                  <span class="nav-badge" data-notifications-badge<%= typeof unreadNotifications !== 'undefined' && unreadNotifications > 0 ? '' : ' hidden' %> aria-hidden="true"><%= typeof unreadNotifications !== 'undefined' && unreadNotifications > 9 ? '9+' : (unreadNotifications || 0) %></span>
                </button>

                <div class="notifications-panel" id="notifications-panel" data-notifications-panel hidden>
                  <header class="notifications-panel-head">
                    <strong>Notifications</strong>
                    <button type="button" class="notifications-panel-readall" data-notifications-read-all>Mark all as read</button>
                  </header>
                  <div class="notifications-panel-list" data-notifications-list></div>
                  <a class="notifications-panel-more" href="/notifications">See all notifications</a>
                </div>
              </div>

              <div class="nav-profile" data-profile-menu-wrap>
                <button type="button" id="profile-menu-button" class="profile-chip" data-profile-menu-button aria-haspopup="menu" aria-expanded="false" aria-controls="profile-menu" aria-label="Open account menu">
                <img src="<%= currentUser.avatar || '/images/default-avatar.svg' %>" alt="" data-fallback-src="/images/default-avatar.svg" />
                <span class="profile-chip-name" data-i18n-skip><%= currentUser.display_name %></span>
                <svg class="profile-chip-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>

              <div class="profile-menu" id="profile-menu" role="menu" aria-labelledby="profile-menu-button" aria-hidden="true" data-profile-menu>
                <div class="profile-menu-head">
                  <img src="<%= currentUser.avatar || '/images/default-avatar.svg' %>" alt="" data-fallback-src="/images/default-avatar.svg" />
                  <span>
                    <strong data-i18n-skip><%= currentUser.display_name %></strong>
                    <small data-i18n-skip>@<%= currentUser.username %></small>
                  </span>
                  <% if (currentUser.role) { %><em><%= currentUser.role %></em><% } %>
                </div>
                <div class="profile-menu-items">
                  <a role="menuitem" href="/profile/<%= currentUser.username %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.4" /><path d="M5.5 19.5c.6-3.3 3.2-5 6.5-5s5.9 1.7 6.5 5" /></svg>
                    Profile
                  </a>
                  <a role="menuitem" href="/dashboard">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 4.5h6v6h-6zM13.5 4.5h6v6h-6zM4.5 13.5h6v6h-6zM13.5 13.5h6v6h-6z" /></svg>
                    My Dashboard
                  </a>
                  <a role="menuitem" href="/profile/<%= currentUser.username %>?tab=artworks">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="1.6" /><path d="m4.8 16 4.2-4.4 3 2.7 3.1-3.6 4.1 5.1" /><circle cx="9" cy="9.2" r="1.2" /></svg>
                    My Artworks
                  </a>
                  <a role="menuitem" href="/profile/edit">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M12 3.8v2M12 18.2v2M3.8 12h2M18.2 12h2M6.2 6.2l1.4 1.4M16.4 16.4l1.4 1.4M17.8 6.2l-1.4 1.4M7.6 16.4l-1.4 1.4" /></svg>
                    Settings
                  </a>
                  <a role="menuitem" href="/notifications">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 10.2a5.5 5.5 0 0 1 11 0c0 4 1.4 5.4 2 6.1.3.4 0 .9-.5.9H5c-.5 0-.8-.5-.5-.9.6-.7 2-2.1 2-6.1Z" /><path d="M10.2 20a2 2 0 0 0 3.6 0" /></svg>
                    Notifications
                  </a>
                  <% if (currentUser.role === 'admin') { %>
                    <a role="menuitem" href="/admin">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 7 3v5c0 4.3-2.9 7.3-7 9-4.1-1.7-7-4.7-7-9v-5l7-3Z" /><path d="m9 12 2 2 4-4.5" /></svg>
                      Admin studio
                    </a>
                  <% } %>
                </div>
                <div class="profile-menu-sep" role="separator"></div>
                <a role="menuitem" class="profile-menu-logout" href="/logout">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5.5H6.5v13H14M10.5 12h9.5m-3-3 3 3-3 3" /></svg>
                  Log out
                </a>
              </div>
              </div>
            <% } else { %>
              <a href="/login" class="nav-auth-link">Login</a>
              <a href="/register" class="nav-auth-join">Join</a>
            <% } %>
          </div>
        </div>

        <button class="nav-backdrop" type="button" data-nav-backdrop tabindex="-1" aria-label="Close menu"></button>
      </header>

      <div class="route-view" data-route-view tabindex="-1" aria-label="Page content">
      <% if (typeof categories !== 'undefined' && categories.length) { %>
        <div class="category-bar">
          <div class="container category-list">
            <a href="/explore?category=all" class="category-pill <%= typeof filter !== 'undefined' && filter === 'all' ? 'active' : '' %>">All</a>
            <% categories.forEach((category) => { %>
              <a href="/explore?category=<%= category.slug %>" class="category-pill <%= typeof filter !== 'undefined' && filter === category.slug ? 'active' : '' %>"><%= category.name %></a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <main id="main-content" class="container main-content <%= pageTitle === 'ArtSpace | Discover original artwork' ? 'home-main' : '' %> <%= typeof pageTitle === 'string' && pageTitle.startsWith('Explore') ? 'explore-main' : '' %> <%= typeof pageTitle === 'string' && pageTitle.includes('Edit artwork') ? 'edit-main' : '' %>">
