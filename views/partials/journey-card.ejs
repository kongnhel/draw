<%
  const journeyPinned = typeof pinnedIds !== 'undefined' && pinnedIds && pinnedIds.has(Number(artwork.id));
  const journeySrc = imageTools.cardSrc(artwork, 640);
  const journeySrcset = imageTools.cardSrcset(artwork, [320, 480, 640, 800]);
%>
<article class="hs-journey-card" data-journey-card data-artwork-view data-artwork-id="<%= artwork.id %>" data-artwork-full="<%= artwork.image_url || artwork.thumbnail_url %>" data-artwork-thumb="<%= artwork.thumbnail_url || artwork.image_url %>" data-artwork-title="<%= artwork.title %>" data-artwork-description="<%= artwork.description || '' %>" data-artwork-category="<%= artwork.category_name || '' %>" data-artwork-tags="<%= artwork.tags || '' %>" data-artwork-effect="<%= artwork.visual_effect || 'auto' %>" data-artwork-artist="<%= artwork.display_name || artwork.username %>" data-artwork-artist-url="/profile/<%= artwork.username %>" data-artwork-date="<%= artwork.created_at_label || 'Original artwork' %>" data-artwork-liked="<%= artwork.is_liked ? 'true' : 'false' %>" data-artwork-saved="<%= artwork.is_bookmarked ? 'true' : 'false' %>" data-artwork-likes="<%= artwork.likes_count || 0 %>">
  <span class="hs-journey-tape" aria-hidden="true"></span>
  <span class="hs-journey-index" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
  <% if (journeyPinned) { %>
    <span class="hs-journey-pin" title="Pinned to the homepage">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6l-.8 4.6 3 3.1v2.1H6.8v-2.1l3-3.1L9 4Z" /><path d="M12 14v6" /></svg>
      Pinned
    </span>
  <% } %>

  <a class="hs-journey-image" href="/art/<%= artwork.id %>" aria-label="View <%= artwork.title %> by <%= artwork.display_name || artwork.username %>">
    <img src="<%= journeySrc %>"<% if (journeySrcset) { %> srcset="<%= journeySrcset %>" sizes="(max-width: 640px) 84vw, (max-width: 1040px) 42vw, 340px"<% } %> width="640" height="800" data-fallback-src="/images/default-artwork.svg" alt="<%= artwork.title %> by <%= artwork.display_name || artwork.username %>" loading="lazy" decoding="async" />
    <span class="hs-journey-open" aria-hidden="true">Open <span>↗</span></span>
  </a>

  <div class="hs-journey-copy">
    <span class="hs-journey-category"><%= artwork.category_name || 'Original artwork' %></span>
    <h3><a href="/art/<%= artwork.id %>"><%= artwork.title %></a></h3>
    <a class="hs-journey-artist" href="/profile/<%= artwork.username %>">
      <img src="<%= artwork.avatar || '/uploads/avatars/default-avatar.svg' %>" data-fallback-src="/uploads/avatars/default-avatar.svg" alt="" loading="lazy" decoding="async" />
      <span>by <%= artwork.display_name || artwork.username %></span>
    </a>
  </div>
</article>
