<%
  const mbnRawPath = typeof currentPath !== 'undefined' ? String(currentPath) : '/';
  const mbnPath = mbnRawPath.split('?')[0] || '/';
  const mbnUsername = typeof currentUser !== 'undefined' && currentUser ? currentUser.username : '';
  const mbnIsAdmin = Boolean(isAuthenticated && currentUser && currentUser.role === 'admin');
  const mbnProfileHref = isAuthenticated && mbnUsername
    ? `/profile/${encodeURIComponent(mbnUsername)}`
    : '/login';
  const mbnActive = {
    home: mbnPath === '/',
    explore: mbnPath.startsWith('/explore') || mbnPath.startsWith('/search'),
    create: mbnPath.startsWith('/upload'),
    community: mbnPath.startsWith('/community'),
    profile: mbnPath === '/profile/edit' || (mbnPath.startsWith('/profile/') && (!mbnUsername || mbnPath === `/profile/${encodeURIComponent(mbnUsername)}` || !isAuthenticated)) || mbnPath.startsWith('/dashboard') || mbnPath.startsWith('/messages') || mbnPath.startsWith('/notifications') || mbnPath.startsWith('/admin')
  };
%>
<% if (!mbnIsAdmin) { %>
<nav class="mobile-bottom-nav" data-mobile-bottom-nav aria-label="Mobile primary navigation">
  <a
    href="/"
    class="mbn-item<%= mbnActive.home ? ' is-active' : '' %>"
    data-mbn-key="home"
    <%- mbnActive.home ? 'aria-current="page"' : '' %>
  >
    <span class="mbn-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.8v-6.2H9.8V21H5a1 1 0 0 1-1-1V10.5Z" /></svg>
    </span>
    <span class="mbn-label">Home</span>
  </a>

  <a
    href="/explore"
    class="mbn-item<%= mbnActive.explore ? ' is-active' : '' %>"
    data-mbn-key="explore"
    <%- mbnActive.explore ? 'aria-current="page"' : '' %>
  >
    <span class="mbn-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="m15.5 8.5-2.2 5-5 2.2 2.2-5 5-2.2Z" /></svg>
    </span>
    <span class="mbn-label">Explore</span>
  </a>

  <a
    href="/upload"
    class="mbn-item mbn-item--create<%= mbnActive.create ? ' is-active' : '' %>"
    data-mbn-key="create"
    aria-label="Upload artwork"
    <%- mbnActive.create ? 'aria-current="page"' : '' %>
  >
    <span class="mbn-create-btn" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 20l2.5-7L16 3.5l4.5 4.5L11 17.5 4 20Z" /><path d="M14 6l4 4M6.5 17.5l2 2" /></svg>
    </span>
    <span class="mbn-label">Upload</span>
  </a>

  <a
    href="/community"
    class="mbn-item<%= mbnActive.community ? ' is-active' : '' %>"
    data-mbn-key="community"
    <%- mbnActive.community ? 'aria-current="page"' : '' %>
  >
    <span class="mbn-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><circle cx="9" cy="9" r="3.2" /><path d="M2.8 19c.6-3 2.9-4.6 6.2-4.6s5.6 1.6 6.2 4.6" /><circle cx="17" cy="10" r="2.6" /><path d="M15.6 14.6c2.9-.3 5 1 5.6 3.6" /></svg>
    </span>
    <span class="mbn-label">Community</span>
  </a>

  <a
    href="<%= mbnProfileHref %>"
    class="mbn-item<%= mbnActive.profile ? ' is-active' : '' %>"
    data-mbn-key="profile"
    <%- mbnActive.profile ? 'aria-current="page"' : '' %>
  >
    <span class="mbn-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="8.2" r="3.6" /><path d="M5.2 20c.7-3.5 3.3-5.4 6.8-5.4s6.1 1.9 6.8 5.4" /></svg>
    </span>
    <span class="mbn-label">Profile</span>
  </a>
</nav>
<% } %>

