<%
  const shareArtwork = item.artwork;
  const sharerName = item.share.sharer_name || item.share.sharer_username;
  const shareDate = new Date(item.share.created_at);
  const shareDateLabel = Number.isNaN(shareDate.getTime())
    ? 'Just now'
    : shareDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const cardSrc = imageTools.cardSrc(shareArtwork, 720);
  const cardSrcset = imageTools.cardSrcset(shareArtwork, [320, 480, 640, 800, 1000]);
  const isShareOwner = typeof currentUser !== 'undefined' && currentUser && Number(currentUser.id) === Number(shareArtwork.user_id);
%>
<article class="social-share-card" data-explore-card data-post-key="<%= item.postKey %>" data-share-id="<%= item.share.id %>" data-artwork-id="<%= shareArtwork.id %>">
  <header class="social-post-head">
    <a class="social-post-avatar" href="/profile/<%= item.share.sharer_username %>" aria-label="View <%= sharerName %>'s profile" data-i18n-skip>
      <img src="<%= item.share.sharer_avatar || '/images/default-avatar.svg' %>" data-fallback-src="/images/default-avatar.svg" alt="" loading="lazy" decoding="async" />
    </a>
    <div class="social-post-head-copy">
      <a class="social-post-name" href="/profile/<%= item.share.sharer_username %>" data-i18n-skip><%= sharerName %></a>
      <p class="social-post-context">
        <span>shared an artwork</span>
        <span class="social-post-dot" aria-hidden="true">·</span>
        <time datetime="<%= Number.isNaN(shareDate.getTime()) ? '' : shareDate.toISOString() %>"><%= shareDateLabel %></time>
      </p>
    </div>
    <button type="button" class="social-post-more" data-post-menu-toggle aria-label="Post options" aria-haspopup="menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="1.7" /><circle cx="12" cy="12" r="1.7" /><circle cx="18" cy="12" r="1.7" /></svg>
    </button>
    <%- include('./post-menu', { artwork: shareArtwork, postKey: item.postKey, isOwner: isShareOwner }) %>
  </header>

  <% if (item.share.message) { %>
    <p class="social-post-message" data-i18n-skip><%- mentionify(item.share.message) %></p>
  <% } %>

  <a class="social-post-art" href="/art/<%= shareArtwork.id %>" aria-label="View <%= shareArtwork.title %> by <%= shareArtwork.display_name || shareArtwork.username %>">
    <img src="<%= cardSrc %>"<% if (cardSrcset) { %> srcset="<%= cardSrcset %>" sizes="(max-width: 640px) 92vw, (max-width: 1080px) 46vw, 420px"<% } %> data-fallback-src="<%= shareArtwork.image_url || '/images/default-artwork.svg' %>" alt="<%= shareArtwork.title %>" loading="lazy" decoding="async" data-i18n-skip />
    <span class="social-post-art-label">
      <strong data-i18n-skip><%= shareArtwork.title %></strong>
      <span>Original artwork by <b data-i18n-skip><%= shareArtwork.display_name || shareArtwork.username %></b></span>
    </span>
  </a>

  <div class="social-post-actions" role="group" aria-label="Post actions">
    <form method="POST" action="/art/<%= shareArtwork.id %>/like" class="social-post-action-form">
          <input type="hidden" name="reaction" value="like" />
      <button type="submit" class="social-post-action<%= shareArtwork.is_liked ? ' is-active' : '' %>" aria-pressed="<%= shareArtwork.is_liked ? 'true' : 'false' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.2-4.6-9.4-9.4A5.4 5.4 0 0 1 12 6.6a5.4 5.4 0 0 1 9.4 4A13.6 13.6 0 0 1 12 20Z" /></svg>
        <span>Like</span>
        <span class="social-post-count" data-explore-likes-for="<%= shareArtwork.id %>"><%= shareArtwork.likes_count || 0 %></span>
      </button>
    </form>
    <a class="social-post-action" href="/art/<%= shareArtwork.id %>#ad-comments">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-3-.4-4.2-1.1L3 21l1.7-4.7A8.4 8.4 0 0 1 3.5 12 8.5 8.5 0 0 1 12 3.5 8.5 8.5 0 0 1 21 12Z" /></svg>
      <span>Comment</span>
      <span class="social-post-count"><%= shareArtwork.comments_count || 0 %></span>
    </a>
    <button type="button" class="social-post-action" data-share-artwork data-share-title="<%= shareArtwork.title %>" data-share-text="<%= shareArtwork.title %> by <%= shareArtwork.display_name || shareArtwork.username %> on ArtSpace" data-share-url="/art/<%= shareArtwork.id %>" data-share-id="<%= shareArtwork.id %>" data-share-image="<%= shareArtwork.thumbnail_url || shareArtwork.image_url %>" data-share-artist="<%= shareArtwork.display_name || shareArtwork.username %>" data-share-category="<%= shareArtwork.category_name || '' %>">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.4" /><circle cx="17.5" cy="5.5" r="2.4" /><circle cx="17.5" cy="18.5" r="2.4" /><path d="M8.3 10.9l7-4.2M8.3 13.1l7 4.2" /></svg>
      <span>Share</span>
    </button>
  </div>
</article>
