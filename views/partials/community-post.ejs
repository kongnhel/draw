<%
  const shareId = share.share_id;
  const artwork = share.artwork;
  const sharer = share.sharer;
  const viewerIsOwner = Number(viewerId || 0) > 0 && Number(viewerId) === Number(sharer.id);
  const postDate = new Date(share.created_at);
  const postDateLabel = Number.isNaN(postDate.getTime())
    ? 'Just now'
    : postDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const cardSrc = imageTools.cardSrc(artwork, 720);
  const cardSrcset = imageTools.cardSrcset(artwork, [320, 480, 640, 800, 1000]);
  const reactionEmojis = { like: '👍', love: '❤️', care: '🥰', haha: '😂', wow: '😮', sad: '😢' };
  const shareText = `${artwork.title} by ${artwork.display_name || artwork.username} on ArtSpace`;
%>
<article class="social-share-card community-post" id="share-<%= shareId %>" data-community-post data-share-id="<%= shareId %>" data-artwork-id="<%= artwork.id %>" data-post-key="share-<%= shareId %>">
  <header class="social-post-head">
    <a class="social-post-avatar" href="/profile/<%= sharer.username %>" aria-label="View <%= sharer.display_name %>'s profile" data-i18n-skip>
      <img src="<%= sharer.avatar || '/images/default-avatar.svg' %>" data-fallback-src="/images/default-avatar.svg" alt="" loading="lazy" decoding="async" />
    </a>
    <div class="social-post-head-copy">
      <a class="social-post-name" href="/profile/<%= sharer.username %>" data-i18n-skip><%= sharer.display_name %></a>
      <p class="social-post-context">
        <span>shared an artwork</span>
        <span class="social-post-dot" aria-hidden="true">·</span>
        <a class="social-post-time" href="/community/<%= shareId %>">
          <time datetime="<%= Number.isNaN(postDate.getTime()) ? '' : postDate.toISOString() %>"><%= postDateLabel %></time>
        </a>
      </p>
    </div>
    <button type="button" class="social-post-more" data-post-menu-toggle aria-label="Post options" aria-haspopup="menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="1.7" /><circle cx="12" cy="12" r="1.7" /><circle cx="18" cy="12" r="1.7" /></svg>
    </button>
    <div class="social-post-menu" data-post-menu hidden role="menu" aria-label="Post options">
      <button type="button" class="social-post-menu-item" role="menuitem" data-community-copy data-share-id="<%= shareId %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7.1 0l2.4-2.4a5 5 0 0 0-7.1-7.1L11 5.9" /><path d="M14 10a5 5 0 0 0-7.1 0L4.5 12.4a5 5 0 0 0 7.1 7.1L13 18.1" /></svg>
        <span>Copy link</span>
      </button>
      <button type="button" class="social-post-menu-item" role="menuitem" data-share-artwork data-share-title="<%= artwork.title %>" data-share-text="<%= shareText %>" data-share-url="/art/<%= artwork.id %>" data-share-id="<%= artwork.id %>" data-share-image="<%= artwork.thumbnail_url || artwork.image_url %>" data-share-artist="<%= artwork.display_name || artwork.username %>" data-share-category="<%= artwork.category_name || '' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.4" /><circle cx="17.5" cy="5.5" r="2.4" /><circle cx="17.5" cy="18.5" r="2.4" /><path d="M8.3 10.9l7-4.2M8.3 13.1l7 4.2" /></svg>
        <span>Share</span>
      </button>
      <% if (viewerIsOwner) { %>
        <button type="button" class="social-post-menu-item" role="menuitem" data-community-edit-toggle data-share-id="<%= shareId %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l11-11a2.1 2.1 0 0 0-3-3L5 17l-1 3Z" /><path d="M13.5 7.5l3 3" /></svg>
          <span>Edit message</span>
        </button>
        <button type="button" class="social-post-menu-item is-danger" role="menuitem" data-community-delete data-share-id="<%= shareId %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M6.5 7l1 13h9l1-13" /></svg>
          <span>Delete share</span>
        </button>
      <% } else if (typeof currentUser !== 'undefined' && currentUser) { %>
        <button type="button" class="social-post-menu-item" role="menuitem" data-community-report data-artwork-id="<%= artwork.id %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v16M6 5c2.5-1.3 4.5-1 7 .8 2.4 1.7 4.3 1.9 5.6.8l-1.4 5 1.4 5c-1.3 1-3.2.8-5.6-.9-2.5-1.8-4.5-2-7-.8" /></svg>
          <span>Report</span>
        </button>
      <% } %>
    </div>
  </header>

  <p class="social-post-message<%= share.message ? '' : ' is-empty' %>" data-share-message data-i18n-skip><%- share.message ? mentionify(share.message) : '' %></p>

  <a class="social-post-art" href="/art/<%= artwork.id %>" aria-label="View <%= artwork.title %> by <%= artwork.display_name || artwork.username %>">
    <img src="<%= cardSrc %>"<% if (cardSrcset) { %> srcset="<%= cardSrcset %>" sizes="(max-width: 640px) 92vw, (max-width: 1080px) 46vw, 420px"<% } %> data-fallback-src="<%= artwork.image_url || '/images/default-artwork.svg' %>" alt="<%= artwork.title %>" loading="lazy" decoding="async" data-i18n-skip />
    <% if (artwork.images_count > 1) { %>
      <span class="community-art-badge" aria-hidden="true"><%= artwork.images_count %> pages</span>
    <% } %>
    <span class="social-post-art-label">
      <strong data-i18n-skip><%= artwork.title %></strong>
      <span>Original artwork by <a href="/profile/<%= artwork.username %>" data-i18n-skip>@<%= artwork.username %></a></span>
    </span>
  </a>

  <div class="social-post-actions community-post-actions" role="group" aria-label="Post actions">
    <div class="community-like-wrap" data-community-reaction>
      <button type="button" class="social-post-action community-like-button<%= share.is_liked ? ' is-active' : '' %>" data-share-like data-share-id="<%= shareId %>" aria-pressed="<%= share.is_liked ? 'true' : 'false' %>" aria-haspopup="menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.2-4.6-9.4-9.4A5.4 5.4 0 0 1 12 6.6a5.4 5.4 0 0 1 9.4 4A13.6 13.6 0 0 1 12 20Z" /></svg>
        <span data-share-like-label><%= share.is_liked ? 'Reacted' : 'Like' %></span>
        <span class="social-post-count" data-share-like-count><%= share.likes_count %></span>
      </button>
      <div class="ad-reaction-picker community-reaction-picker" data-share-reaction-menu hidden role="menu" aria-label="Choose a reaction">
        <% ['like', 'love', 'care', 'haha', 'wow', 'sad'].forEach((type) => { %>
          <button type="button" class="ad-reaction-choice<%= share.viewer_reaction === type ? ' is-active' : '' %>" data-share-reaction="<%= type %>" data-share-id="<%= shareId %>" role="menuitem" aria-label="<%= type.charAt(0).toUpperCase() + type.slice(1) %>" title="<%= type.charAt(0).toUpperCase() + type.slice(1) %>">
            <span class="ad-reaction-choice-emoji"><%= reactionEmojis[type] %></span>
            <span class="ad-reaction-choice-label"><%= type.charAt(0).toUpperCase() + type.slice(1) %></span>
          </button>
        <% }) %>
      </div>
    </div>
    <a class="social-post-action" href="/community/<%= shareId %>#share-comments">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-3-.4-4.2-1.1L3 21l1.7-4.7A8.4 8.4 0 0 1 3.5 12 8.5 8.5 0 0 1 12 3.5 8.5 8.5 0 0 1 21 12Z" /></svg>
      <span>Comment</span>
      <span class="social-post-count" data-share-comments-count><%= share.comments_count %></span>
    </a>
    <button type="button" class="social-post-action" data-share-artwork data-share-title="<%= artwork.title %>" data-share-text="<%= shareText %>" data-share-url="/art/<%= artwork.id %>" data-share-id="<%= artwork.id %>" data-share-image="<%= artwork.thumbnail_url || artwork.image_url %>" data-share-artist="<%= artwork.display_name || artwork.username %>" data-share-category="<%= artwork.category_name || '' %>">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.4" /><circle cx="17.5" cy="5.5" r="2.4" /><circle cx="17.5" cy="18.5" r="2.4" /><path d="M8.3 10.9l7-4.2M8.3 13.1l7 4.2" /></svg>
      <span>Share</span>
      <span class="social-post-count" data-share-shares-count><%= artwork.shares_count %></span>
    </button>
  </div>

  <p class="community-post-meta" data-share-meta>
    <span data-share-summary-count><%= share.likes_count %></span>
    <span data-share-summary-label><%= share.likes_count === 1 ? 'reaction' : 'reactions' %></span>
    <span class="community-post-meta-dot" aria-hidden="true">·</span>
    <span data-share-comments-label><%= share.comments_count === 1 ? 'comment' : 'comments' %></span>
    <span class="community-post-meta-dot" aria-hidden="true">·</span>
    <span data-share-shares-label><%= artwork.shares_count === 1 ? 'share' : 'shares' %></span>
  </p>
</article>
