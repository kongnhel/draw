<div class="mood-atmosphere" data-mood-atmosphere aria-hidden="true"></div>

<div class="mood-backdrop" data-mood-backdrop aria-hidden="true"></div>

<aside class="mood-panel" id="mood-panel" role="dialog" aria-modal="false" aria-labelledby="mood-panel-title" aria-hidden="true" data-mood-panel>
  <span class="mood-tape mood-tape--left" aria-hidden="true"></span>
  <span class="mood-tape mood-tape--right" aria-hidden="true"></span>

  <button type="button" class="mood-panel-close" data-mood-close aria-label="Close mood selector">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
  </button>

  <header class="mood-panel-head">
    <p class="mood-panel-kicker">Sketchbook atmosphere</p>
    <h2 id="mood-panel-title">Choose a mood</h2>
    <p class="mood-panel-current">Currently <strong data-mood-current-name>COOL</strong> <span class="mood-panel-dot" aria-hidden="true">·</span> <span data-mood-status>Music ready</span></p>
  </header>

  <div class="mood-options" role="group" aria-label="Mood options">
    <button type="button" class="mood-option mood-option--cool" data-mood="cool" aria-pressed="false">
      <span class="mood-option-icon" aria-hidden="true">❄️</span>
      <span class="mood-option-copy">
        <strong>COOL</strong>
        <small>Snowfall &amp; chill lo-fi</small>
      </span>
      <span class="mood-option-mark" aria-hidden="true"></span>
    </button>

    <button type="button" class="mood-option mood-option--love" data-mood="love" aria-pressed="false">
      <span class="mood-option-icon" aria-hidden="true">💕</span>
      <span class="mood-option-copy">
        <strong>LOVE</strong>
        <small>Soft hearts &amp; love piano</small>
      </span>
      <span class="mood-option-mark" aria-hidden="true"></span>
    </button>

    <button type="button" class="mood-option mood-option--romantic" data-mood="romantic" aria-pressed="false">
      <span class="mood-option-icon" aria-hidden="true">🌹</span>
      <span class="mood-option-copy">
        <strong>ROMANTIC</strong>
        <small>Rose petals &amp; dreamy piano</small>
      </span>
      <span class="mood-option-mark" aria-hidden="true"></span>
    </button>

    <button type="button" class="mood-option mood-option--sad" data-mood="sad" aria-pressed="false">
      <span class="mood-option-icon" aria-hidden="true">🌧️</span>
      <span class="mood-option-copy">
        <strong>SAD</strong>
        <small>Rain &amp; melancholic piano</small>
      </span>
      <span class="mood-option-mark" aria-hidden="true"></span>
    </button>
  </div>

  <div class="mood-music">
    <div class="mood-music-head">
      <span class="mood-music-title">Original mood music</span>
      <span class="mood-eq" data-mood-eq aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </div>
    <div class="mood-volume-row">
      <button type="button" class="mood-volume-icon" data-mood-mute aria-label="Mute mood music" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 10v4h4l5 4V6l-5 4H4Z" />
          <path class="mood-volume-waves" d="M16 9a5 5 0 0 1 0 6m3-9a9 9 0 0 1 0 12" />
          <path class="mood-volume-cross" d="m16.5 9.5 5 5m0-5-5 5" />
        </svg>
      </button>
      <label class="sr-only" for="mood-volume-slider">Mood music volume</label>
      <input id="mood-volume-slider" class="mood-volume-slider" type="range" min="0" max="100" step="1" value="45" data-mood-volume />
      <output class="mood-volume-value" data-mood-volume-value for="mood-volume-slider">45%</output>
    </div>
    <p class="mood-music-note">Composed live in your browser from soft piano, pads and air. No two listens are quite the same.</p>
  </div>

  <footer class="mood-panel-foot">
    <span aria-hidden="true">✦</span>
    <span>Your mood and volume are saved on this device.</span>
  </footer>
</aside>

<button class="mood-fab" type="button" data-mood-toggle aria-label="Open mood selector" aria-expanded="false" aria-controls="mood-panel">
  <span class="mood-fab-icon" data-mood-current-icon aria-hidden="true">❄️</span>
  <span class="mood-fab-copy">
    <small>Mood</small>
    <strong data-mood-current-label>COOL</strong>
  </span>
  <span class="mood-fab-eq" data-mood-eq aria-hidden="true"><i></i><i></i><i></i><i></i></span>
</button>

<div class="mood-start" data-mood-start-overlay hidden>
  <div class="mood-start-card" role="dialog" aria-modal="true" aria-labelledby="mood-start-title">
    <span class="mood-start-tape" aria-hidden="true"></span>
    <p class="mood-start-kicker">An emotional digital sketchbook</p>
    <h2 id="mood-start-title">Tap to start <em>the experience</em></h2>
    <p class="mood-start-copy">Choose a feeling. The sketchbook will shift its light, particles and original music to match.</p>
    <div class="mood-start-options" role="group" aria-label="Choose a starting mood">
      <button type="button" data-start-mood="cool"><span aria-hidden="true">❄️</span>Cool</button>
      <button type="button" data-start-mood="love"><span aria-hidden="true">💕</span>Love</button>
      <button type="button" data-start-mood="romantic"><span aria-hidden="true">🌹</span>Romantic</button>
      <button type="button" data-start-mood="sad"><span aria-hidden="true">🌧️</span>Sad</button>
    </div>
    <button type="button" class="mood-start-button" data-mood-start>Tap to Start Experience</button>
    <p class="mood-start-note">Headphones recommended · music begins softly</p>
    <button type="button" class="mood-start-skip" data-mood-start-skip>Continue without music</button>
  </div>
</div>
