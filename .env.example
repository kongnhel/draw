# Aiven MySQL Connection (placeholders only - never commit real credentials)
AIVEN_MYSQL_HOST=your-aiven-mysql-host.aivencloud.com
AIVEN_MYSQL_PORT=12345
AIVEN_MYSQL_DATABASE=draw_web_db
AIVEN_MYSQL_USER=avnadmin
# AIVEN_MYSQL_PASSWORD=your_aiven_password_here
AIVEN_MYSQL_SSL=required
AIVEN_MYSQL_SSL_CA_PATH=/path/to/aiven/ca-certificate.pem

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Session
SESSION_SECRET=replace-with-a-long-random-string

# Node.js Version
ENGINE_NODE_VERSION=20.x

# Application
PORT=3000
HOST=0.0.0.0
