# Server
# Port 80 serves both http://localhost and http://<LAN-IP> without a port.
PORT=80
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost

# Security - generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Uploads
UPLOAD_MAX_FILES=6
UPLOAD_MAX_SIZE_MB=8

# Mail (leave empty in development to use the built-in mock inbox at /dev/inbox)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ArtSpace <no-reply@artspace.local>"
