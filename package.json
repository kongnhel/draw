{
  "name": "artspace",
  "version": "1.0.0",
  "description": "ArtSpace - Art & Drawing Social Platform. Upload, share, explore and appreciate artwork.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/book-slider-tailwind.css --minify",
    "dev:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/book-slider-tailwind.css --watch",
    "seed": "node src/db/seed.js",
    "db:create": "node scripts/create-database.js",
    "db:verify": "node scripts/verify-schema.js",
    "test:messaging": "node scripts/test-messaging.js"
  },
  "keywords": [
    "art",
    "drawing",
    "social",
    "gallery",
    "express"
  ],
  "author": "ArtSpace",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "imagekit": "^6.0.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemon": "^3.1.14",
    "page-flip": "^2.0.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
